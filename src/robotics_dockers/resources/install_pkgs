#!/usr/bin/env bash
# Install one complete set of apt packages in a single apt invocation.
#
# Calling apt separately for each package could install the early packages before
# discovering that a later name is invalid. A separate simulated installation is
# deliberately avoided: the real apt command performs the same dependency
# resolution and Docker discards the RUN layer if that command fails. Apt itself
# is not transactional, so this helper does not promise rollback outside a build.

log() {
    local level="${1:-info}"
    shift || true
    printf '[%s] [%s] %s\n' "$(date --utc '+%Y-%m-%dT%H:%M:%SZ')" "${level}" "$*"
}

handle_error() {
    local exit_code="${1:-1}"
    shift || true
    log error "${*:-Unknown error} (exit code: ${exit_code})" >&2
    exit "${exit_code}"
}

executing_user_id="$(id --user 2>/dev/null)" ||
    handle_error 1 "Could not determine which UID is executing install_pkgs"

if [ "${executing_user_id}" -ne 0 ]; then
    handle_error 1 "install_pkgs must run as UID 0; found UID '${executing_user_id}'"
fi

if [ "$#" -eq 0 ]; then
    exit 0
fi

packages=("$@")
# ${packages[*]} joins the array elements with spaces for log messages. The apt
# commands below use "${packages[@]}" so every package remains a separate argument.
log info "Installing one apt package set: ${packages[*]}"

apt-get --yes --no-install-recommends install "${packages[@]}" ||
    handle_error 1 "apt failed while installing package set: ${packages[*]}"
