# https://docs.docker.com/compose/environment-variables/#the-env-file
services:
  {{ service }}:
    image: {{ img_id }}

    # No user override is needed. The image was built with the final development
    # UID and GID and declares that account with its Dockerfile USER instruction.

    privileged: false

    # Keep only if you really need to create or modify network interfaces
    # inside the container.
    # cap_add:
    #   - NET_ADMIN # Enable only when a project must create or modify network devices.

    # ROS 2/DDS development is usually simpler with host networking,
    # especially for discovery, multicast/unicast and robot/sensor networks.
    network_mode: host

    # Gives the container a larger private /dev/shm.
    # This is useful for ROS 2, Gazebo, RViz, cameras, OpenCV,
    # Python multiprocessing and large DDS messages.
    # Ref: https://docs.nvidia.com/deeplearning/frameworks/user-guide/index.html#setincshmem
    shm_size: "2gb"

    # Enable only if shared-memory IPC between host and container is required.
    # Usually not needed when all ROS 2 nodes run inside the same container.
    # ipc: host

    tty: true
    stdin_open: true

    {% if use_host_nvidia_driver %}
    # Modern way to expose NVIDIA GPU (requires NVIDIA Container Toolkit).
    # Replaces the legacy 'runtime: nvidia' approach.
    # Ref: https://docs.docker.com/compose/how-tos/gpu-support/
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    {% endif %}

    tmpfs:
      # Compose creates the volatile XDG directory with the same numeric identity
      # that was stored in the image. The entrypoint validates it but never
      # changes its mode or ownership.
      - "/run/user/${IMAGE_USER_ID:?IMAGE_USER_ID required}:mode=700,uid=${IMAGE_USER_ID:?IMAGE_USER_ID required},gid=${IMAGE_USER_PRIMARY_GROUP_ID:?IMAGE_USER_PRIMARY_GROUP_ID required}"

    volumes:
      # +------------------+
      # | Project mappings |
      # +------------------+
      # Keep project mounts outside the development home so they cannot hide the
      # environment files installed there. No runtime ownership repair occurs.
      # The :? form makes Compose stop during interpolation with the stated
      # explanation when a required local value is unset or empty.
      {% if enable_workspace_mount %}
      - "${HOST_WORKSPACE:?HOST_WORKSPACE must match the workspace path on this host}:{{ img_workspace_dir }}"
      {% else %}
      # robotics_dockers does not know whether this image belongs to a project
      # or where that project lives on the host. Uncomment the following line
      # when a workspace must be mounted, then define HOST_WORKSPACE in the
      # environment file selected with docker compose --env-file.
      # - "${HOST_WORKSPACE:?HOST_WORKSPACE must match the workspace path on this host}:{{ img_workspace_dir }}"
      {% endif %}

      # +------------------+
      # | Dataset mappings |
      # +------------------+
      # The suggested target is also outside the development home.
      #- ~/datasets:{{ img_datasets_dir }}

      # +-------------------+
      # | Graphics mappings |
      # +-------------------+
      # The host-side installer generates the XWayland authentication file
      # before this service is created:
      #
      #   scripts/install-docker-gui-support.sh
      - type: bind
        source: "${HOST_XAUTHORITY_FILE:?HOST_XAUTHORITY_FILE must match the Xauthority file path on this host}"
        target: "/run/user/${IMAGE_USER_ID:?IMAGE_USER_ID required}/docker-xwayland.xauth"
        read_only: true
        bind:
          create_host_path: false

      - /tmp/.X11-unix:/tmp/.X11-unix:ro

      # +-----------------+
      # | Custom mappings |
      # +-----------------+
      # Folders
      # ...
      # Files
      # ...

      # +----------------------+
      # | SSH agent forwarding |
      # +----------------------+
      # Do not mount ${HOME}/.ssh into the container. That exposes private
      # key files to every process inside the container.
      #
      # Instead, mount only the host ssh-agent Unix socket. The container can
      # ask the agent to sign SSH challenges, but it does not receive the
      # private key files.
      #
      # If you enable this volume, also set this environment variable:
      #
      #   SSH_AUTH_SOCK: /ssh-agent
      #
      # The :? syntax makes docker compose fail early if SSH_AUTH_SOCK is not
      # set in the host shell.
      #
      #   - "${SSH_AUTH_SOCK:?SSH_AUTH_SOCK must match the SSH agent socket path on this host}:/ssh-agent"

      # +-----------------+
      # | Device mappings |
      # +-----------------+
      - /dev/input:/dev/input

    devices:
      # - /dev/ttyACM0:/dev/ttyACM0
      - /dev/bus/usb:/dev/bus/usb
      - /dev/dri:/dev/dri

    #device_cgroup_rules:
    #  - "c 13:* rmw" # input
    #  - "c 166:* rmw" # ttyACM
    #  - "c 180:* rmw" # usb
    #  - "c 189:* rmw" # usb_device

    environment:
      # Use the host XWayland display and the Xauthority file mounted above.
      DISPLAY: "${DISPLAY:?DISPLAY must match the graphical display available on this host}"
      XDG_RUNTIME_DIR: "/run/user/${IMAGE_USER_ID:?IMAGE_USER_ID required}"
      XAUTHORITY: "/run/user/${IMAGE_USER_ID:?IMAGE_USER_ID required}/docker-xwayland.xauth"
      CONTAINER_ROS_WORKSPACE: "{{ img_workspace_dir }}"

      # Force Qt applications such as RViz and Gazebo to use X11 through
      # XWayland instead of attempting a native Wayland connection.
      QT_QPA_PLATFORM: "xcb"
      QT_X11_NO_MITSHM: "1"

      # ${TERM:-xterm-256color} uses the host TERM value when it is non-empty
      # and otherwise supplies the shown default.
      TERM: "${TERM:-xterm-256color}"
      {% if use_host_nvidia_driver %}
      NVIDIA_VISIBLE_DEVICES: "all"
      NVIDIA_DRIVER_CAPABILITIES: "all"
      {% endif %}

    # Add the GID of the render device group so that all container processes
    # (including those opened by VS Code) can access /dev/dri/renderD* for
    # GPU-accelerated rendering (Gazebo, RViz, OpenGL).
    #
    # How to find the value for your machine:
    #   stat -c %g /dev/dri/renderD128
    #
    # How to provide RENDER_GID (choose one):
    #   1. Put the value in an environment file:
    #        # env_files/production.env
    #        RENDER_GID=992
    #      Then select that file explicitly when Compose starts:
    #        docker compose --env-file env_files/production.env --file compose_files/docker-compose.yaml up
    #   2. Export in your shell before running docker compose:
    #        export RENDER_GID=$(stat -c %g /dev/dri/renderD128)
    #        docker compose --file compose_files/docker-compose.yaml up
    #   3. Inline when running docker compose:
    #        RENDER_GID=$(stat -c %g /dev/dri/renderD128) \
    #          docker compose --file compose_files/docker-compose.yaml up
    #
    # group_add is supplementary: it does not replace the primary GID stored in
    # the image and therefore does not prevent the entrypoint from loading the
    # development environment. Docker also applies it to docker exec processes.
    group_add:
      - "${RENDER_GID:?RENDER_GID must match the GID owning the selected renderD device on this host}"

    # init: true enables a tiny init (tini) as PID 1 inside the container.
    # It forwards signals (SIGTERM/SIGINT) to the app and reaps zombie
    # processes from child workers, preventing dirty shutdowns and resource
    # leaks.
    #
    # It is not a supervisor: it will not restart your app. It only fixes
    # PID-1 semantics.
    #
    # Recommended for services that spawn subprocesses or use launchers/daemons,
    # for example ros2 launch, drivers, simulators and agent tooling.
    init: true
