#!/usr/bin/env python3

import argparse
import os
import shlex
{% if rosdep_packages_dir_mode == 'cli' %}
import shutil
{% endif %}
import subprocess
import sys
{% if rosdep_packages_dir_mode == 'cli' %}
import tempfile
{% endif %}
from datetime import datetime, timezone
from pathlib import Path

if __name__ == '__main__':
    # ----------------------------------------------------------------------------------------------
    # Main execution block
    # ----------------------------------------------------------------------------------------------
    parser = argparse.ArgumentParser(
        description=(
            'Builds the Docker image "{{ img_id }}" using the base image "{{ base_img }}", '
            'with development user "{{ user }}" and "ROS 2 {{ ros_distro }}"'
        ),
        allow_abbrev=False,  # Disable prefix matching
        add_help=False,  # Add custom help message
        formatter_class=lambda prog: argparse.RawTextHelpFormatter(prog, max_help_position=38),
    )

    parser.add_argument(
        '-h', '--help', action='help', default=argparse.SUPPRESS, help='Show this help message and exit'
    )

    parser.add_argument(
        '--no-cache',
        action='store_true',
        help='Rebuild every Dockerfile step instead of reusing BuildKit cache entries.',
    )

    parser.add_argument(
        '-p',
        '--pull',
        action='store_true',
        help=(
            'Checks if a newer version of the base image is available in the proper registry (e.g., Docker Hub).\n'
            'If a newer version is found, it downloads and uses it. If the latest version is already available\n'
            'locally it will not download it again. Without --pull Docker uses the local copy of the base image\n'
            'if it is available on the system. If no local copy exists, Docker will download it automatically.\n'
            'Usage of --pull is recommended to ensure an updated base image is used.'
        ),
    )

{% if rosdep_packages_dir is none %}
    parser.add_argument(
        '--pkgs-dir',
        type=str,
        default=None,
        help=(
            'Path to the ROS packages directory on the host (e.g. /home/user/workspace/src).\n'
            'If provided, rosdep will install the dependencies of those packages into the image.'
        ),
    )
{% endif %}

    args = parser.parse_args()
    this_file = Path(__file__).resolve()

    # Resolve every generated resource relative to this file. The generated
    # directory can therefore be moved or checked out at any host path.

    # Jinja's tojson filter produces a quoted string literal with control
    # characters escaped. It is valid Python syntax and prevents a configured
    # path or label from breaking this generated script.
    base_img = {{ base_img | tojson }}
    user = {{ user | tojson }}
    img_id_to_build = {{ img_id | tojson }}

    context_dir = this_file.parent
    dockerfile = context_dir.joinpath('Dockerfile')
    resources_dir = context_dir.joinpath('.resources')

    if not dockerfile.is_file():
        print(f"Error: File '{str(dockerfile)}' is required")
        sys.exit(1)

    if not resources_dir.is_dir():
        print(f"Error: Directory '{str(resources_dir)}' is required")
        sys.exit(1)

    # The generated Dockerfile uses RUN bind mounts. Invoke the Docker CLI with
    # BuildKit enabled so those mounts and their automatic cache invalidation
    # are available.
    os.environ['DOCKER_BUILDKIT'] = '1'

    cmd = [
        'docker',
        'build',
        '--file',
        str(dockerfile.resolve()),
        '--progress=plain',
    ]

    if args.pull:
        print(f"--pull specified. Docker build will attempt to pull/update base image '{base_img}'")
        cmd.append('--pull')

    if args.no_cache:
        cmd.append('--no-cache')

    labels = {
        'org.opencontainers.image.created': datetime.now(timezone.utc).isoformat(),
    }

    for k, v in labels.items():
        cmd += ['--label', f'{k}={v}']

    cmd.extend(['--tag', img_id_to_build])
    # Always declare a 'pkgs' build context so the Dockerfile mount is always valid.
{% if rosdep_packages_dir_mode == 'cli' %}
    # The generated build script does not know where the ROS packages live.
    # If --pkgs-dir is provided, it points to the ROS packages directory.
    # Otherwise, an empty temporary directory is used.
    if args.pkgs_dir:
        pkgs_dir = Path(args.pkgs_dir).expanduser().resolve()

        if not pkgs_dir.is_dir():
            print(f"Error: --pkgs-dir '{pkgs_dir}' does not exist or is not a directory", file=sys.stderr)
            sys.exit(1)
    else:
        pkgs_dir = Path(tempfile.mkdtemp(prefix='pkgs_empty_', dir='/tmp'))
{% elif rosdep_packages_dir_mode == 'fixed_relative' %}
    # The generator already knows where the ROS packages live. Relative paths are resolved from
    # this build script's directory, which is the generated Docker output directory.
    pkgs_dir = context_dir.joinpath({{ rosdep_packages_dir | tojson }}).resolve()

    if not pkgs_dir.is_dir():
        print(
            f'Error: configured ROS packages directory "{pkgs_dir}" does not exist or is not a directory',
            file=sys.stderr,
        )
        sys.exit(1)
{% elif rosdep_packages_dir_mode == 'fixed_host_path' %}
    # The generator already knows where the ROS packages live. Host paths are resolved independently
    # from this build script's directory, so absolute paths and '~' paths keep their host meaning.
    pkgs_dir = Path({{ rosdep_packages_dir | tojson }}).expanduser().resolve()

    if not pkgs_dir.is_dir():
        print(
            f'Error: configured ROS packages directory "{pkgs_dir}" does not exist or is not a directory',
            file=sys.stderr,
        )
        sys.exit(1)
{% endif %}

    cmd += ['--build-context', f'pkgs={pkgs_dir}']
    cmd.append(str(context_dir))

    print(
        f'Building the Docker image "{img_id_to_build}" using the base image "{base_img}", '
        f'with development user "{user}" and "ROS 2 {{ ros_distro }}"'
    )
    print('Executing command:')
    # Quote for display exactly as a user would need to paste the argv into a
    # POSIX shell. subprocess still receives the original list directly.
    print(shlex.join(cmd))

    exit_code = 0

    try:
        result = subprocess.run(cmd)
        exit_code = result.returncode

        if exit_code == 0:
            print(f'\nDocker build process ended with SUCCESS for the image "{img_id_to_build}"')
        else:
            print(
                f'\nDocker build process ended with FAILURE (exit code {exit_code}) '
                f'for the image "{img_id_to_build}"'
            )
    except KeyboardInterrupt:
        print('Aborted by user (Ctrl-C)')
        exit_code = 130
    # subprocess.run can raise OSError when the Docker executable cannot be
    # started. Do not catch every Exception: a programming error should retain
    # its traceback instead of being disguised as a Docker launch failure.
    except OSError as error:
        print(f'Error: could not start Docker: {error}', file=sys.stderr)
        exit_code = 1
    finally:
{% if rosdep_packages_dir_mode == 'cli' %}
        # Clean up the temporary empty pkgs directory if it was created.
        if not args.pkgs_dir and pkgs_dir.exists():
            shutil.rmtree(pkgs_dir, ignore_errors=True)
{% endif %}
        sys.exit(exit_code)
