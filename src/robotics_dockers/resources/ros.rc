#!/usr/bin/env bash
# This file is sourced by .env.rc to set up ROS 2 shell integration.

# --------------------------------------------------------------------------------------------------
# source_base_ros_setup
#
# Sources the base ROS 2 setup with the following priority:
#   1) ${ROS_DISTRO}/setup.bash if ROS_DISTRO is explicitly set
#   2) Auto-detect when exactly one distro is found in /opt/ros (sets ROS_DISTRO)
#
# Returns 0 on success, 1 when no valid ROS setup could be sourced.
# Emits a warning instead of exiting so the shell remains usable.
# --------------------------------------------------------------------------------------------------
source_base_ros_setup() {
    local ros_setup_path=""
    local ros_distro_count=0
    local detected_ros_distro=""
    local candidate=""

    if [ -n "${ROS_DISTRO:-}" ]; then
        ros_setup_path="/opt/ros/${ROS_DISTRO}/setup.bash"

        if [ ! -s "${ros_setup_path}" ]; then
            echo "Warning: no ROS setup loaded (ROS_DISTRO is set to '${ROS_DISTRO}' but setup.bash was not found); continuing without ROS environment" >&2
            return 1
        fi
    else
        for candidate in /opt/ros/*; do
            if [ ! -s "${candidate}/setup.bash" ]; then
                continue
            fi

            ros_distro_count=$((ros_distro_count + 1))
            detected_ros_distro="${candidate##*/}"
        done

        case "${ros_distro_count}" in
        0)
            echo "Warning: no ROS setup loaded (no valid setup found); continuing without ROS environment" >&2
            return 1
            ;;
        1)
            export ROS_DISTRO="${detected_ros_distro}"
            ros_setup_path="/opt/ros/${ROS_DISTRO}/setup.bash"
            echo "Info: ROS_DISTRO unset; auto-selected '${ROS_DISTRO}' from /opt/ros" >&2
            ;;
        *)
            echo "Warning: no ROS setup loaded (ROS_DISTRO unset and multiple ROS distros found in /opt/ros); continuing without ROS environment" >&2
            return 1
            ;;
        esac
    fi

    # shellcheck disable=SC1090
    if . "${ros_setup_path}"; then
        return 0
    fi

    echo "Warning: failed to source ${ros_setup_path}; continuing without ROS environment" >&2
    return 1
}

# --------------------------------------------------------------------------------------------------
# source_ros_setup
#
# Sources the workspace overlay when available. If the workspace is not configured, its setup file
# is missing, or sourcing it fails, falls back to the base ROS 2 setup.
# --------------------------------------------------------------------------------------------------
source_ros_setup() {
    local workspace_setup_path=""

    if [ -z "${CONTAINER_ROS_WORKSPACE:-}" ]; then
        echo "Warning: CONTAINER_ROS_WORKSPACE is not set; falling back to base ROS setup" >&2
        source_base_ros_setup
        return
    fi

    workspace_setup_path="${CONTAINER_ROS_WORKSPACE}/install/setup.bash"

    if [ ! -s "${workspace_setup_path}" ]; then
        echo "Warning: workspace setup not found at ${workspace_setup_path}; falling back to base ROS setup" >&2
        source_base_ros_setup
        return
    fi

    # shellcheck disable=SC1090
    if . "${workspace_setup_path}"; then
        return 0
    fi

    echo "Warning: failed to source workspace overlay; falling back to base ROS setup" >&2
    source_base_ros_setup
}

source_ros_setup

# Optional ROS tooling hooks.
if [ -s /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ]; then
    # shellcheck disable=SC1091
    . /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash
fi

if [ -s /usr/share/colcon_cd/function/colcon_cd.sh ]; then
    # shellcheck disable=SC1091
    . /usr/share/colcon_cd/function/colcon_cd.sh
fi

unset -f source_ros_setup
unset -f source_base_ros_setup

return 0
