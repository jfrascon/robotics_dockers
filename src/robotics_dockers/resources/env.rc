#!/usr/bin/env bash
# Shared user environment sourced by the user entrypoint and interactive .bashrc.

# This file must be sourced so the variables it exports affect the current shell.
# If the file is ${HOME}/.env.rc and it is executed as
# ${HOME}/.env.rc:
# then
# BASH_SOURCE[0]=${HOME}/.env.rc and $0=${HOME}/.env.rc.

# If it is sourced with
# . ${HOME}/.env.rc'
# from another Bash script or shell, then:
# BASH_SOURCE[0]=${HOME}/.env.rc and $0 is that script or shell.

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    echo "Error: ${BASH_SOURCE[0]} must be sourced, not executed." >&2
    exit 1
fi

if [ "${ROBOTICS_DOCKERS_ENV_LOADED:-}" = "1" ]; then
    return 0
fi

export ROBOTICS_DOCKERS_ENV_LOADED=1

ensure_default_user_dir() {
    local dir="${1}"

    mkdir -p "${dir}" || {
        echo "Error: failed to create directory '${dir}'" >&2
        return 1
    }

    chmod 755 "${dir}" || {
        echo "Error: failed to set mode 755 on directory '${dir}'" >&2
        return 1
    }
}

ensure_xdg_user_dir() {
    local name="${1}"
    local dir="${2}"

    case "${dir}" in
    "${HOME}" | "${HOME}"/*)
        ensure_default_user_dir "${dir}"
        return
        ;;
    *)
        echo "Warning: ${name} points outside HOME; this environment setup will not create or change it: ${dir}" >&2
        ;;
    esac
}

ensure_default_user_dir "${HOME}/.local/bin" || return 1

export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"

ensure_xdg_user_dir XDG_CACHE_HOME "${XDG_CACHE_HOME}" || return 1
ensure_xdg_user_dir XDG_CONFIG_HOME "${XDG_CONFIG_HOME}" || return 1
ensure_xdg_user_dir XDG_DATA_HOME "${XDG_DATA_HOME}" || return 1
ensure_xdg_user_dir XDG_STATE_HOME "${XDG_STATE_HOME}" || return 1

# Ensure ~/.local/bin is in PATH (user-local binaries installed by pip, etc.).
# The check avoids duplicating it if already present.
[[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]] && export PATH="${HOME}/.local/bin:${PATH}"

# ROS shell integration.
# shellcheck disable=SC1091
[ -f "${HOME}/.ros.rc" ] && . "${HOME}/.ros.rc"
