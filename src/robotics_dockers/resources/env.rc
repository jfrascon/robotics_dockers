#!/usr/bin/env bash
# Shared development environment sourced by the entrypoint and interactive Bash.

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    echo "Error: ${BASH_SOURCE[0]} must be sourced, not executed." >&2
    exit 1
fi

if [ "${ROBOTICS_DOCKERS_ENV_LOADED:-}" = "1" ]; then
    return 0
fi

if [ -z "${HOME:-}" ]; then
    echo "Error: HOME must be defined before loading ${BASH_SOURCE[0]}" >&2
    return 1
fi

if [ ! -d "${HOME}" ]; then
    echo "Error: HOME '${HOME}' must identify an existing directory before loading ${BASH_SOURCE[0]}" >&2
    return 1
fi

ensure_user_directory() {
    local directory="${1}"
    # --mode applies only to a directory created by this call. Existing user
    # directories keep the mode deliberately chosen by the user.
    # shellcheck disable=SC2174
    if ! mkdir --parents --mode 0755 -- "${directory}"; then
        echo "Error: could not create user directory '${directory}'" >&2
        return 1
    fi
}

ensure_xdg_directory() {
    local variable_name="${1}"
    local directory="${2}"
    case "${directory}" in
    "${HOME}" | "${HOME}"/*) ensure_user_directory "${directory}" ;;
    *) echo "Warning: ${variable_name} points outside HOME and will not be created or modified: ${directory}" >&2 ;;
    esac
}

prepend_existing_path() {
    local directory="${1}"
    if [ ! -d "${directory}" ]; then
        return 0
    fi
    case ":${PATH}:" in
    *:"${directory}":*) ;;
    *) PATH="${directory}:${PATH}" ;;
    esac
}

# ${XDG_CACHE_HOME:-${HOME}/.cache} keeps an existing non-empty XDG value and
# otherwise builds the standard cache path below HOME.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
# ${XDG_CONFIG_HOME:-${HOME}/.config} keeps an existing non-empty XDG value and
# otherwise builds the standard configuration path below HOME.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
# ${XDG_DATA_HOME:-${HOME}/.local/share} keeps an existing non-empty XDG value
# and otherwise builds the standard data path below HOME.
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
# ${XDG_STATE_HOME:-${HOME}/.local/state} keeps an existing non-empty XDG value
# and otherwise builds the standard state path below HOME.
export XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"

if ! ensure_xdg_directory XDG_CACHE_HOME "${XDG_CACHE_HOME}"; then
    return 1
fi

if ! ensure_xdg_directory XDG_CONFIG_HOME "${XDG_CONFIG_HOME}"; then
    return 1
fi

if ! ensure_xdg_directory XDG_DATA_HOME "${XDG_DATA_HOME}"; then
    return 1
fi

if ! ensure_xdg_directory XDG_STATE_HOME "${XDG_STATE_HOME}"; then
    return 1
fi

if ! ensure_user_directory "${HOME}/.local/bin"; then
    return 1
fi

# Add cargo first and local second so the final priority is:
# ~/.local/bin, ~/.cargo/bin, then the original system PATH.
prepend_existing_path "${HOME}/.cargo/bin"
prepend_existing_path "${HOME}/.local/bin"
export PATH

if [ -f "${HOME}/.ros.rc" ]; then
    # shellcheck disable=SC1091
    if ! . "${HOME}/.ros.rc"; then
        return 1
    fi
fi

environment_hooks_directory="${HOME}/.env.d"
if [ -d "${environment_hooks_directory}" ]; then
    if [ ! -r "${environment_hooks_directory}" ]; then
        echo "Error: environment hook directory '${environment_hooks_directory}' must be readable" >&2
        return 1
    fi

    if [ ! -x "${environment_hooks_directory}" ]; then
        echo "Error: environment hook directory '${environment_hooks_directory}' must be searchable" >&2
        return 1
    fi

    mapfile -d '' -t environment_hooks < <(
        find "${environment_hooks_directory}" -maxdepth 1 -type f -name '*.rc' -print0 | LC_ALL=C sort -z
    )
    for environment_hook in "${environment_hooks[@]}"; do
        # shellcheck disable=SC1090
        if ! . "${environment_hook}"; then
            echo "Error: environment hook '${environment_hook}' failed" >&2
            return 1
        fi
    done
fi

# Mark the environment as loaded only after every required source operation has
# succeeded. A failed hook can then be corrected and reload_envrc can retry it.
export ROBOTICS_DOCKERS_ENV_LOADED=1
unset environment_hook environment_hooks environment_hooks_directory
unset -f ensure_user_directory ensure_xdg_directory prepend_existing_path
return 0
