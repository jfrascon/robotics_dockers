#!/usr/bin/env bash

# Purpose
# -------
# This entrypoint adapts one non-root development user from the Docker image to
# the UID and primary GID requested by the person starting the container.

# THE RESULTING NUMERIC IDENTIFIERS MATCH THE HOST USER, SO FILES CREATED THROUGH
# BIND MOUNTS HAVE THE EXPECTED OWNER ON THE HOST.
#
# What this script changes
# ------------------------
# The adaptation may change:
#   * The UID field of IMAGE_MAIN_USER in /etc/passwd.
#   * The primary GID field of IMAGE_MAIN_USER in /etc/passwd.
#   * Group names in /etc/group. The shadow-utils group commands apply the same
#     group-name changes to /etc/gshadow.
#   * The UID and/or GID of matching files below IMAGE_MAIN_USER's home.
#   * The UID owner of IMAGE_MAIN_USER's mailbox when HOST_UID changes, if that
#     mailbox exists and is owned by IMAGE_MAIN_USER_ID.
#
# This script does not change:
#   * IMAGE_MAIN_USER's login name, home path, shell, password, or supplementary
#     group membership.
#   * The numeric GID of any existing group. The script never uses
#     groupmod --gid because that command would change the primary GID of every
#     user whose /etc/passwd entry contains the old GID, but would leave all file
#     GIDs unchanged.
#   * File ownership outside IMAGE_MAIN_USER's home, except for the mailbox UID
#     change performed by usermod --uid.
#   * Render-device access. /dev/dri/renderD* access must be configured with
#     docker-compose group_add so every container process inherits that group.
#
# Names used by the adaptation
# ----------------------------
# IMAGE_MAIN_USER
#   The development user's login name stored in the image.
# IMAGE_MAIN_USER_ID
#   Documentation-only name for the UID assigned to IMAGE_MAIN_USER before the
#   adaptation starts.
# IMAGE_MAIN_USER_PRIMARY_GID
#   Documentation-only name for the primary GID assigned to IMAGE_MAIN_USER
#   before the adaptation starts.
# The script does not read IMAGE_MAIN_USER_ID or IMAGE_MAIN_USER_PRIMARY_GID as
# environment variables. The actual local shell variables are:
# image_main_user_id
#   Stores IMAGE_MAIN_USER_ID.
# image_main_user_pri_group_id
#   Stores IMAGE_MAIN_USER_PRIMARY_GID.
# image_main_user_pri_group
#   The local group name associated with IMAGE_MAIN_USER_PRIMARY_GID.
# HOST_UID
#   The UID requested for IMAGE_MAIN_USER when the container starts.
# HOST_UPGID
#   The primary GID requested for IMAGE_MAIN_USER when the container starts.
#
# Required state before any account or group is changed
# -----------------------------------------------------
# The script completes every validation of the initial container state before
# the first usermod, groupmod, or groupadd command. Checks of command results and
# final postconditions necessarily occur while or after those commands run.
# In particular:
#   * IMAGE_MAIN_USER must have exactly one entry in /etc/passwd. The UID field
#     defines IMAGE_MAIN_USER_ID and must not appear in any other local
#     /etc/passwd entry.
#   * The primary GID field in IMAGE_MAIN_USER's /etc/passwd entry defines
#     IMAGE_MAIN_USER_PRIMARY_GID and must identify exactly one /etc/group entry.
#     The name stored in that group entry must not appear in any other local
#     /etc/group entry.
#   * /etc/group and /etc/gshadow must contain the same group names exactly once.
#     groupmod changes both files, so an orphan or duplicate /etc/gshadow name
#     could otherwise be overwritten while /etc/group appears valid.
#   * If HOST_UID = IMAGE_MAIN_USER_ID, no UID change is required. If
#     HOST_UID != IMAGE_MAIN_USER_ID, HOST_UID must be absent from /etc/passwd.
#     HOST_UID may not be assigned to another user.
#   * If HOST_UPGID = IMAGE_MAIN_USER_PRIMARY_GID, no primary GID change is
#     required. If HOST_UPGID != IMAGE_MAIN_USER_PRIMARY_GID, HOST_UPGID may be
#     absent from /etc/group or may identify exactly one other group. If it
#     identifies multiple group entries, the script cannot determine which
#     group to rename and stops before making changes.
#   * Every UID and GID used by the adaptation must be between 1000 and
#     4294967294. Linux reserves 4294967295 as the invalid UID/GID value, and
#     shadow-utils rejects it.
#   * The home directory itself must have UID IMAGE_MAIN_USER_ID. This allows
#     usermod to perform its home ownership changes; usermod skips them when the
#     directory UID differs from both the UID before and the UID after usermod.
#   * The home directory itself must have GID IMAGE_MAIN_USER_PRIMARY_GID. This
#     ensures that the directory's own GID is changed to HOST_UPGID during the
#     selective home traversal. A different GID would be preserved by usermod.
#   * The complete home directory may not be a mount point because mounting it
#     hides image-installed files such as .entrypoint.sh and .env.rc.
#   * .entrypoint.sh must be executable and .env.rc must be readable when access
#     is tested with IMAGE_MAIN_USER_ID and IMAGE_MAIN_USER_PRIMARY_GID.
#   * XDG_RUNTIME_DIR must have its expected path and must be absent or already
#     be a real directory. A symbolic link or another file type is rejected.

# How usermod changes the account and home ownership
# --------------------------------------------------
# usermod --uid has these effects:
#   * HOST_UID must not belong to another user unless --non-unique is also used.
#     This script never uses --non-unique and verifies that HOST_UID is free
#     before changing IMAGE_MAIN_USER_ID.
#   * The UID field of IMAGE_MAIN_USER in /etc/passwd becomes HOST_UID.
#   * If IMAGE_MAIN_USER's mailbox exists and is owned by
#     IMAGE_MAIN_USER_ID, its UID owner becomes HOST_UID. A mailbox owned by a
#     different UID is left unchanged and usermod prints a warning.
#   * Within IMAGE_MAIN_USER's home:
#       If a file is owned by numeric UID IMAGE_MAIN_USER_ID before usermod,
#       usermod changes that file's owner to numeric UID HOST_UID.
#     A file owned by any other numeric UID keeps that UID.
#
# usermod --gid has these effects:
#   * The group passed to --gid must already exist. The script therefore
#     completes every required groupadd or groupmod command before usermod.
#   * The primary GID field of IMAGE_MAIN_USER in /etc/passwd becomes
#     HOST_UPGID.
#   * Within IMAGE_MAIN_USER's home:
#       If a file's owning group has numeric GID IMAGE_MAIN_USER_PRIMARY_GID
#       before usermod, usermod changes that file's owning group to numeric GID
#       HOST_UPGID.
#     A file whose owning group has any other numeric GID keeps that GID.
#
# For each file, usermod checks the numeric user owner and the numeric owning
# group separately. Consequently, usermod may change only the UID,
# only the GID, both identifiers, or neither identifier for a particular file.
#
# Apart from the mailbox change performed by --uid, usermod does not change file
# ownership outside IMAGE_MAIN_USER's home. This script deliberately leaves
# those external files unchanged. If one must continue to belong to
# IMAGE_MAIN_USER after adaptation, its ownership must be handled separately by
# the image or project that created it.
#
# usermod may update /etc/passwd successfully but skip all home ownership
# changes when the home directory UID differs from both IMAGE_MAIN_USER_ID and
# HOST_UID. The initial validation rejects that state before any account or group
# record is changed.
#
# Decision matrix
# ---------------
# In the conditions below, = means "is equal to" and != means "is different
# from". These symbols describe comparisons; they are not Bash assignments.
#
# When the matrix preserves the group with IMAGE_MAIN_USER_PRIMARY_GID, its new
# name is rd_old_<IMAGE_MAIN_USER_PRIMARY_GID>. If that name already exists, the
# script tries suffixes _1, _2, and so on until it finds an unused name. Renaming
# this group does not change its GID.
#
# * HOST_UID = IMAGE_MAIN_USER_ID and HOST_UPGID = IMAGE_MAIN_USER_PRIMARY_GID.
#   - Do not change any user or group record.
#   - Do not run usermod or traverse IMAGE_MAIN_USER's home.
#     Example:
#       HOST_UID = IMAGE_MAIN_USER_ID = 1001
#       HOST_UPGID = IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#       /etc/group has:
#         developer:x:1001:
#       Commands: none
#       Result: the user and group records remain unchanged, and the home is not
#       traversed.
# * HOST_UID != IMAGE_MAIN_USER_ID and HOST_UPGID = IMAGE_MAIN_USER_PRIMARY_GID.
#   - If HOST_UID is assigned to another user, assigning it to IMAGE_MAIN_USER
#     would give both accounts the same numeric UID. Linux access checks use the
#     numeric UID, so both accounts would receive the same owner permissions and
#     files could not be assigned exclusively to one account by UID. The script
#     therefore fails before changing any user or group record.
#     Example:
#       HOST_UID = 2001
#       HOST_UPGID = IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       IMAGE_MAIN_USER_ID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#         builder:x:2001:2001::/home/builder:/bin/bash
#       Commands: none
#       Result: initial validation fails before any user or group record is
#       changed.
#   - If HOST_UID is absent from /etc/passwd, run one usermod with --uid.
#     Example:
#       HOST_UID = 2001
#       HOST_UPGID = IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       IMAGE_MAIN_USER_ID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#       No /etc/passwd entry has UID 2001.
#       Commands:
#         usermod --uid 2001 developer
#       Result:
#         /etc/passwd has developer:x:2001:1001::/home/developer:/bin/bash
#         /etc/group still has developer:x:1001:
#         Home files owned by UID 1001 are changed to UID 2001; files owned by
#         any other UID are unchanged.
# * HOST_UID = IMAGE_MAIN_USER_ID and HOST_UPGID != IMAGE_MAIN_USER_PRIMARY_GID.
#   - If HOST_UPGID appears in multiple /etc/group entries, several group names
#     represent the same numeric GID. The script could not select one entry to
#     receive the original primary group name and leave exactly one group with
#     HOST_UPGID. It therefore fails before changing any user or group record.
#     Example:
#       HOST_UID = IMAGE_MAIN_USER_ID = 1001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/group has:
#         developer:x:1001:
#         alpha:x:2001:
#         beta:x:2001:
#       Commands: none
#       Result: initial validation fails before any user or group record is
#       changed.
#   - If /etc/group has no entry with GID HOST_UPGID, rename the group whose GID
#     is IMAGE_MAIN_USER_PRIMARY_GID to a generated name so that the
#     renamed group keeps IMAGE_MAIN_USER_PRIMARY_GID. Then create a group with
#     GID HOST_UPGID and the original primary group name.
#     Example:
#       HOST_UID = IMAGE_MAIN_USER_ID = 1001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/group has:
#         developer:x:1001:
#       No /etc/group entry has GID 2001.
#       Commands:
#         groupmod --new-name rd_old_1001 developer
#         groupadd --gid 2001 developer
#         usermod --gid 2001 developer
#       Result:
#         /etc/passwd has developer:x:1001:2001::/home/developer:/bin/bash
#         /etc/group has rd_old_1001:x:1001:
#         /etc/group has developer:x:2001:
#         Home files owned by GID 1001 are changed to GID 2001; files owned by
#         any other GID are unchanged.
#   - If HOST_UPGID appears in exactly one /etc/group entry, preserve the
#     existing primary group under a generated name and assign the original
#     primary group name to the group that has HOST_UPGID.
#     Example:
#       HOST_UID = IMAGE_MAIN_USER_ID = 1001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/group has:
#         developer:x:1001:
#         host_users:x:2001:
#       Commands:
#         groupmod --new-name rd_old_1001 developer
#         groupmod --new-name developer host_users
#         usermod --gid 2001 developer
#       Result:
#         /etc/passwd has developer:x:1001:2001::/home/developer:/bin/bash
#         /etc/group has rd_old_1001:x:1001:
#         /etc/group has developer:x:2001:
#         Home files owned by GID 1001 are changed to GID 2001; files owned by
#         any other GID are unchanged.
# * HOST_UID != IMAGE_MAIN_USER_ID and HOST_UPGID != IMAGE_MAIN_USER_PRIMARY_GID.
#   - If HOST_UID is assigned to another user, assigning it to IMAGE_MAIN_USER
#     would give both accounts the same numeric UID. Linux access checks use the
#     numeric UID, so both accounts would receive the same owner permissions and
#     files could not be assigned exclusively to one account by UID. The script
#     therefore fails before changing any user or group record.
#     Example:
#       HOST_UID = 2001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_ID = 1001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#         builder:x:2001:2001::/home/builder:/bin/bash
#       Commands: none
#       Result: initial validation fails before any user or group record is
#       changed.
#   - If HOST_UPGID appears in multiple /etc/group entries, several group names
#     represent the same numeric GID. The script could not select one entry to
#     receive the original primary group name and leave exactly one group with
#     HOST_UPGID. It therefore fails before changing any user or group record.
#     Example:
#       HOST_UID = 2001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_ID = 1001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#       No /etc/passwd entry has UID 2001.
#       /etc/group has:
#         developer:x:1001:
#         alpha:x:2001:
#         beta:x:2001:
#       Commands: none
#       Result: initial validation fails before any user or group record is
#       changed.
#   - If HOST_UID is absent from /etc/passwd and HOST_UPGID is absent from
#     /etc/group, preserve the existing primary group under a generated name and
#     create a group with HOST_UPGID and the original primary group name.
#     Example:
#       HOST_UID = 2001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_ID = 1001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#       No /etc/passwd entry has UID 2001.
#       /etc/group has:
#         developer:x:1001:
#       No /etc/group entry has GID 2001.
#       Commands:
#         groupmod --new-name rd_old_1001 developer
#         groupadd --gid 2001 developer
#         usermod --uid 2001 --gid 2001 developer
#       Result:
#         /etc/passwd has developer:x:2001:2001::/home/developer:/bin/bash
#         /etc/group has rd_old_1001:x:1001:
#         /etc/group has developer:x:2001:
#         In every home file, UID 1001 becomes UID 2001 and any other UID is
#         preserved. Separately, GID 1001 becomes GID 2001 and any other GID is
#         preserved.
#   - If HOST_UID is absent from /etc/passwd and HOST_UPGID appears in exactly
#     one /etc/group entry, preserve the existing primary group under a generated
#     name and assign the original primary group name to the group that has
#     HOST_UPGID.
#     Example:
#       HOST_UID = 2001
#       HOST_UPGID = 2001
#       IMAGE_MAIN_USER_ID = 1001
#       IMAGE_MAIN_USER_PRIMARY_GID = 1001
#       /etc/passwd has:
#         developer:x:1001:1001::/home/developer:/bin/bash
#       No /etc/passwd entry has UID 2001.
#       /etc/group has:
#         developer:x:1001:
#         host_users:x:2001:
#       Commands:
#         groupmod --new-name rd_old_1001 developer
#         groupmod --new-name developer host_users
#         usermod --uid 2001 --gid 2001 developer
#       Result:
#         /etc/passwd has developer:x:2001:2001::/home/developer:/bin/bash
#         /etc/group has rd_old_1001:x:1001:
#         /etc/group has developer:x:2001:
#         In every home file, UID 1001 becomes UID 2001 and any other UID is
#         preserved. Separately, GID 1001 becomes GID 2001 and any other GID is
#         preserved.
#
# Mounts below the home
# ---------------------
# Mounts below the home are not detected, pruned, or treated specially. If a
# caller adds such a mount, usermod traverses it and applies the same selective
# UID/GID rules used for image-owned home content.
#
# Failure limits
# --------------
# groupmod, groupadd, and usermod run as separate commands. If one command fails,
# changes made by earlier commands remain in the container.
#
# usermod can also fail after making some changes. It updates /etc/passwd before
# it finishes changing file ownership in the home. If an error occurs while
# processing the home, /etc/passwd may contain the new UID and GID while only
# some home files have their new ownership.
#
# The script checks for known problems before the first user or group change.
# After the commands finish, it checks /etc/passwd, /etc/group, and the ownership
# of the home directory. An error message states which operations finished
# before the error.
#
# The script does not try to restore the previous state automatically. After a
# partial home update, it cannot know which files were already changed. Trying
# to reverse the operation could assign incorrect ownership to more files.
#
# Work performed around adaptation
# --------------------------------
# Before UID/GID adaptation, this entrypoint validates XDG_RUNTIME_DIR and, when
# requested, checks NVIDIA visibility. After adaptation, it runs root hooks from
# /etc/entrypoint.d, prepares the already validated XDG_RUNTIME_DIR, and uses
# setpriv to start IMAGE_MAIN_USER's entrypoint. The final process receives both
# the supplementary groups recorded for IMAGE_MAIN_USER and numeric groups added
# to the container by Docker. Root hooks must set ownership themselves for any
# files that they create in IMAGE_MAIN_USER's home.

# This script does not use set -e. Commands that can prevent a correct startup
# are checked where they run so the reported error can identify the failed step.

# HOST_UID and HOST_UPGID are supplied through the container environment.

LOG_DIR="/run/robotics-dockers"
LOG_FILE="${LOG_DIR}/entrypoint.log"
MAX_USER_GROUP_ID=4294967294
REMEMBER_MSG="UID/GID adaptation requires the container to be started as root (UID 0) with both HOST_UID and HOST_UPGID defined as integers between 1000 and ${MAX_USER_GROUP_ID}"
INITIAL_VALIDATION_UNCHANGED_MSG="UID/GID adaptation has not started; no user or group account has been changed"

# Remove leading zeroes without using Bash arithmetic. Arithmetic expansion is
# unsafe until the input length is bounded because a very long digit string can
# exceed Bash's integer range. An input containing only zeroes becomes "0".
normalize_decimal_id() {
    local value="${1}"
    local leading_zeroes

    leading_zeroes="${value%%[!0]*}"
    value="${value#"${leading_zeroes}"}"
    printf '%s\n' "${value:-0}"
}

# Return a deterministic, unused local name for the group that retains
# IMAGE_MAIN_USER_PRIMARY_GID. This helper reads /etc/group directly because
# groupmod changes only the local group database; a result returned by getent
# could come from a remote source that groupmod cannot modify.
generate_preserved_group_name() {
    local old_group_id="${1}"
    local candidate
    local suffix=0

    candidate="rd_old_${old_group_id}"

    while true; do
        awk -F: -v name="${candidate}" '$1 == name { found = 1 } END { exit(found ? 0 : 1) }' /etc/group

        case "$?" in
        0)
            suffix=$((suffix + 1))
            candidate="rd_old_${old_group_id}_${suffix}"
            ;;
        1) break ;;
        *) return 1 ;;
        esac
    done

    printf '%s\n' "${candidate}"
}

log() {
    local level="info"
    local out_fd=1

    case "$1" in
    info)
        level="info"
        shift
        ;;
    error)
        level="error"
        shift
        out_fd=2
        ;;
    warning)
        level="warning"
        shift
        ;;
    success)
        level="success"
        shift
        ;;
    debug)
        level="debug"
        shift
        ;;
    *) ;;
    esac

    local ts
    ts="$(date --utc '+%Y-%m-%dT%H:%M:%SZ')"
    local line="[${ts}] [${level}] $*"

    [ -n "${LOG_FILE-}" ] && printf '%s\n' "${line}" >>"${LOG_FILE}"
    printf '%s\n' "${line}" >&"${out_fd}"
}

handle_error() {
    local exit_code="${1:-1}"
    local message="${2:-Unknown error}"
    log error "${message}"
    exit "${exit_code}"
}

print_banner() {
    local message="${1}"
    local fd="${2:-1}"          # default to 1 (stdout) if not provided
    local border_char="${3:--}" # default to '-' if not provided

    # Validate that fd is either 1 (stdout) or 2 (stderr)
    if [ "${fd}" != "1" ] && [ "${fd}" != "2" ]; then
        fd=1
    fi

    local line=" ${message} "
    local len
    len="$(printf '%s' "${line}" | wc -c)"
    local border
    border="$(printf "%${len}s" | tr ' ' "${border_char}")"

    [ -n "${LOG_FILE-}" ] && printf '%s\n%s\n%s\n' "${border}" "${line}" "${border}" >>"${LOG_FILE}"
    printf '%s\n' "${border}" >&"${fd}"
    printf '%s\n' "${line}" >&"${fd}"
    printf '%s\n' "${border}" >&"${fd}"
}

# Define the check in every generated entrypoint. USE_HOST_NVIDIA_DRIVER decides
# whether it runs, so both the template and every rendered variant remain valid
# Bash without placing Jinja control statements inside shell syntax.
nvidia_gpu_driver_check() {
    local libcuda_from_ld_cache
    local libcuda_from_ld_library_path=""
    local libcuda_found
    local driver_found="false"
    local library_path
    local library_paths=()

    # Check if libcuda.so.1, the CUDA driver, is present in the ld.so cache or in LD_LIBRARY_PATH.
    libcuda_from_ld_cache="$(ldconfig -p 2>/dev/null | grep 'libcuda.so.1' || true)"

    if [ -n "${LD_LIBRARY_PATH:-}" ]; then
        IFS=: read -ra library_paths <<<"${LD_LIBRARY_PATH}"
        for library_path in "${library_paths[@]}"; do
            [ -z "${library_path}" ] && continue
            if [[ -e "${library_path}/libcuda.so.1" && ${library_path} != *compat* ]]; then
                libcuda_from_ld_library_path+="${library_path}/libcuda.so.1"
            fi
        done
    fi

    libcuda_found="${libcuda_from_ld_cache}${libcuda_from_ld_library_path}"

    # Check common NVIDIA device nodes: Linux, WSL2, and Tegra.
    if [ -e /dev/nvidiactl ] || [ -e /dev/dxg ] || [ -e /dev/nvgpu ]; then
        driver_found="true"
    fi

    # If either condition is false, GPU functionality will not be usable.
    if [ -z "${libcuda_found}" ] || [ "${driver_found}" != "true" ]; then
        echo >&2
        echo "ERROR: The NVIDIA Driver was not detected. GPU functionality will not be available." >&2
        echo "   Use the NVIDIA Container Toolkit to start this container with GPU support; see" >&2
        echo "   https://docs.nvidia.com/datacenter/cloud-native/ ." >&2
        return 1
    fi

    log info "NVIDIA driver detected inside the container"
}

run_root_entrypoint_hooks() {
    local root_hooks_dir="${1}"
    local root_hooks_found=0
    local root_hook_file

    # A hook is an optional project script that runs at a defined point during startup.
    # These hooks run as root after UID/GID adaptation and before setpriv starts
    # the final development process.
    # Shell scripts are executed with bash, not sourced, so exported variables do not
    # leak into the final user session.
    if [ ! -d "${root_hooks_dir}" ]; then
        log info "Root hook directory '${root_hooks_dir}' does not exist; skipping project startup hooks"
        return 0
    fi

    while IFS= read -r -d '' root_hook_file; do
        root_hooks_found=1

        case "${root_hook_file}" in
        *.txt)
            log info "Printing root hook text file '${root_hook_file}'"
            cat "${root_hook_file}" || handle_error 1 "Root hook text file '${root_hook_file}' failed"
            ;;
        *.sh)
            log info "Running root hook script '${root_hook_file}'"
            bash "${root_hook_file}" || handle_error 1 "Root hook script '${root_hook_file}' failed"
            ;;
        *) ;;
        esac
    done < <(find "${root_hooks_dir}" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.sh' \) -print0 | sort -z)

    if [ "${root_hooks_found}" -eq 0 ]; then
        log info "No root hooks found in '${root_hooks_dir}'"
    fi
}

#---------------------------------------------------------------------------------------------------
# Script execution
#---------------------------------------------------------------------------------------------------
# Read only the two properties needed from the process that executes this
# entrypoint. Its UID must be 0. Its primary GID is excluded later so the final
# development process does not inherit root's primary group.
entrypoint_user_id="$(id --user 2>/dev/null)" || {
    echo "Error: failed to determine the entrypoint user ID" >&2
    exit 1
}

entrypoint_primary_group_id="$(id --group 2>/dev/null)" || {
    echo "Error: failed to determine the entrypoint user's primary group ID" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# The account name and /etc/passwd entry of the executing user are not needed.
# Linux grants the required privileges based on the numeric UID, which must be
# 0.
# ---------------------------------------------------------------------------
if [ "${entrypoint_user_id}" -ne 0 ]; then
    echo "Error: this entrypoint must run with UID 0; found UID '${entrypoint_user_id}'. ${REMEMBER_MSG}" >&2
    exit 1
fi

# Keep the log owned by UID:GID 0:0 so only root can modify it. Directory mode
# 0755 and file mode 0644 allow every container user to read the startup log.
# Reject a symbolic link in the directory path. Replace the previous log file
# before opening the new one so a symbolic link or hard link at LOG_FILE cannot
# make the root entrypoint truncate another file.
if [ -L "${LOG_DIR}" ]; then
    echo "Error: entrypoint log directory '${LOG_DIR}' must not be a symbolic link" >&2
    exit 1
elif [ -e "${LOG_DIR}" ] && [ ! -d "${LOG_DIR}" ]; then
    echo "Error: entrypoint log path '${LOG_DIR}' exists but is not a directory" >&2
    exit 1
fi

install --directory --mode 755 --owner 0 --group 0 "${LOG_DIR}" || {
    echo "Error: failed to create entrypoint log directory '${LOG_DIR}'" >&2
    exit 1
}

if { [ -e "${LOG_FILE}" ] || [ -L "${LOG_FILE}" ]; } && ! rm --force -- "${LOG_FILE}"; then
    echo "Error: failed to remove previous entrypoint log path '${LOG_FILE}'" >&2
    exit 1
fi

install --mode 644 --owner 0 --group 0 /dev/null "${LOG_FILE}" || {
    echo "Error: failed to create entrypoint log file '${LOG_FILE}' with UID:GID 0:0 and mode 0644" >&2
    exit 1
}

print_banner "Entrypoint: starting container for user '${IMAGE_MAIN_USER}'"

script="${BASH_SOURCE:-${0}}"
log info "Executing script '${script}' with UID '${entrypoint_user_id}'"

# ---------------------------------------------------------------------------
# Phase 1: validate HOST_UID and HOST_UPGID.
#
# Leading zeroes are accepted and removed as text. For example, 001001 becomes
# 1001. The length is checked before numeric comparisons, which prevents Bash
# integer overflow and gives a clear error for IDs rejected by shadow-utils.
# ---------------------------------------------------------------------------
if [ -z "${HOST_UID:-}" ] || ! [[ ${HOST_UID} =~ ^[0-9]+$ ]]; then
    handle_error 1 "HOST_UID must be a non-empty sequence of decimal digits; found '${HOST_UID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}. ${REMEMBER_MSG}"
fi

HOST_UID="$(normalize_decimal_id "${HOST_UID}")"

if [[ ${HOST_UID} =~ ^[0-9]{11,}$ ]] || [ "${HOST_UID}" -gt "${MAX_USER_GROUP_ID}" ]; then
    handle_error 1 "HOST_UID must be less than or equal to '${MAX_USER_GROUP_ID}'; found decimal value '${HOST_UID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}. ${REMEMBER_MSG}"
elif [ "${HOST_UID}" -lt 1000 ]; then
    handle_error 1 "HOST_UID must be greater than or equal to 1000; found decimal value '${HOST_UID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}. ${REMEMBER_MSG}"
fi

if [ -z "${HOST_UPGID:-}" ] || ! [[ ${HOST_UPGID} =~ ^[0-9]+$ ]]; then
    handle_error 1 "HOST_UPGID must be a non-empty sequence of decimal digits; found '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}. ${REMEMBER_MSG}"
fi

HOST_UPGID="$(normalize_decimal_id "${HOST_UPGID}")"

if [[ ${HOST_UPGID} =~ ^[0-9]{11,}$ ]] || [ "${HOST_UPGID}" -gt "${MAX_USER_GROUP_ID}" ]; then
    handle_error 1 "HOST_UPGID must be less than or equal to '${MAX_USER_GROUP_ID}'; found decimal value '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}. ${REMEMBER_MSG}"
elif [ "${HOST_UPGID}" -lt 1000 ]; then
    handle_error 1 "HOST_UPGID must be greater than or equal to 1000; found decimal value '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}. ${REMEMBER_MSG}"
fi

log info "Requested host identifiers: HOST_UID '${HOST_UID}', HOST_UPGID '${HOST_UPGID}'"

# ---------------------------------------------------------------------------
# Phase 2: read and validate the image user's local account state.
#
# Read /etc/passwd and /etc/group directly to detect duplicate local users and
# groups.
# getent may return only one match and hide the other duplicates.
# ---------------------------------------------------------------------------
[ -z "${IMAGE_MAIN_USER:-}" ] && handle_error 1 "IMAGE_MAIN_USER must contain the local image user name; found an empty value. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if ! command -v awk >/dev/null 2>&1; then
    handle_error 1 "Command 'awk' is required to read the local user and group databases, but it is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ ! -r /etc/passwd ]; then
    handle_error 1 "Local file '/etc/passwd' must be readable before '${IMAGE_MAIN_USER}' can be adapted. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ ! -r /etc/group ]; then
    handle_error 1 "Local file '/etc/group' must be readable before the primary group of '${IMAGE_MAIN_USER}' can be adapted. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ ! -r /etc/gshadow ]; then
    handle_error 1 "Local file '/etc/gshadow' must be readable before group names can be changed safely. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# /etc/passwd must contain exactly one IMAGE_MAIN_USER entry; otherwise the
# script cannot determine which record to change.
image_main_user_entry_count="$(awk -F: -v user="${IMAGE_MAIN_USER}" '$1 == user { count++ } END { print count + 0 }' /etc/passwd)" || \
    handle_error 1 "Failed to count entries named '${IMAGE_MAIN_USER}' in local file '/etc/passwd'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if [ "${image_main_user_entry_count}" -eq 0 ]; then
    handle_error 1 "Local file '/etc/passwd' has no entry named '${IMAGE_MAIN_USER}'; exactly one entry is required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ "${image_main_user_entry_count}" -ne 1 ]; then
    handle_error 1 "Local file '/etc/passwd' has '${image_main_user_entry_count}' entries named '${IMAGE_MAIN_USER}'; exactly one entry is required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

image_main_user_entry="$(awk -F: -v user="${IMAGE_MAIN_USER}" '$1 == user { print; exit }' /etc/passwd)" || \
    handle_error 1 "Failed to read the local /etc/passwd entry named '${IMAGE_MAIN_USER}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
# The /etc/passwd entry must have exactly seven colon-separated fields.
# <username>:<password>:<UID>:<GID>:<GECOS>:<home directory>:<shell>
image_main_user_field_count="$(awk -F: '{ print NF }' <<<"${image_main_user_entry}")" || \
    handle_error 1 "Failed to count fields in the local /etc/passwd entry for '${IMAGE_MAIN_USER}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if [ "${image_main_user_field_count}" -ne 7 ]; then
    handle_error 1 "The local /etc/passwd entry for '${IMAGE_MAIN_USER}' has '${image_main_user_field_count}' colon-separated fields; exactly seven fields are required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

IFS=: read -r _ _ image_main_user_id image_main_user_pri_group_id _ image_main_user_home \
    image_main_user_shell <<<"${image_main_user_entry}"

# The project reserves values below 1000 for root and system accounts. IDs read
# from the account database must already use their canonical decimal form, with
# no leading zeroes.
if ! [[ ${image_main_user_id} =~ ^[1-9][0-9]*$ ]]; then
    handle_error 1 "The UID field for '${IMAGE_MAIN_USER}' must be a decimal integer without leading zeroes; found '${image_main_user_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [[ ${image_main_user_id} =~ ^[0-9]{11,}$ ]] || [ "${image_main_user_id}" -gt "${MAX_USER_GROUP_ID}" ]; then
    handle_error 1 "The UID field for '${IMAGE_MAIN_USER}' must be less than or equal to '${MAX_USER_GROUP_ID}'; found '${image_main_user_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ "${image_main_user_id}" -lt 1000 ]; then
    handle_error 1 "The UID field for '${IMAGE_MAIN_USER}' must be greater than or equal to 1000; found '${image_main_user_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if ! [[ ${image_main_user_pri_group_id} =~ ^[1-9][0-9]*$ ]]; then
    handle_error 1 "The primary GID field for '${IMAGE_MAIN_USER}' must be a decimal integer without leading zeroes; found '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [[ ${image_main_user_pri_group_id} =~ ^[0-9]{11,}$ ]] || [ "${image_main_user_pri_group_id}" -gt "${MAX_USER_GROUP_ID}" ]; then
    handle_error 1 "The primary GID field for '${IMAGE_MAIN_USER}' must be less than or equal to '${MAX_USER_GROUP_ID}'; found '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ "${image_main_user_pri_group_id}" -lt 1000 ]; then
    handle_error 1 "The primary GID field for '${IMAGE_MAIN_USER}' must be greater than or equal to 1000; found '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# IMAGE_MAIN_USER_ID must be used only by IMAGE_MAIN_USER.
image_main_user_uid_entry_count="$(awk -F: -v uid="${image_main_user_id}" '$3 == uid { count++ } END { print count + 0 }' /etc/passwd)" || \
    handle_error 1 "Failed to count local /etc/passwd entries with UID '${image_main_user_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if [ "${image_main_user_uid_entry_count}" -ne 1 ]; then
    handle_error 1 "UID '${image_main_user_id}' is used by '${image_main_user_uid_entry_count}' local /etc/passwd entries; exactly the entry for '${IMAGE_MAIN_USER}' must use it. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# IMAGE_MAIN_USER_PRIMARY_GID must identify exactly one local group.
image_main_user_group_gid_entry_count="$(awk -F: -v gid="${image_main_user_pri_group_id}" '$3 == gid { count++ } END { print count + 0 }' /etc/group)" || \
    handle_error 1 "Failed to count local /etc/group entries with GID '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if [ "${image_main_user_group_gid_entry_count}" -eq 0 ]; then
    handle_error 1 "Local file '/etc/group' has no entry with GID '${image_main_user_pri_group_id}', which /etc/passwd assigns as the primary GID of '${IMAGE_MAIN_USER}'; exactly one entry is required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ "${image_main_user_group_gid_entry_count}" -ne 1 ]; then
    handle_error 1 "GID '${image_main_user_pri_group_id}', which is the primary GID of '${IMAGE_MAIN_USER}', is used by '${image_main_user_group_gid_entry_count}' local /etc/group entries; exactly one entry is required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

image_main_user_pri_group_entry="$(awk -F: -v gid="${image_main_user_pri_group_id}" '$3 == gid { print; exit }' /etc/group)" || \
    handle_error 1 "Failed to read the local /etc/group entry with GID '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

# The /etc/group entry must have exactly four colon-separated fields.
# <group name>:<password>:<GID>:<comma-separated list of members>
image_main_user_pri_group_field_count="$(awk -F: '{ print NF }' <<<"${image_main_user_pri_group_entry}")" || \
    handle_error 1 "Failed to count fields in the local /etc/group entry with GID '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if [ "${image_main_user_pri_group_field_count}" -ne 4 ]; then
    handle_error 1 "The local /etc/group entry with GID '${image_main_user_pri_group_id}' has '${image_main_user_pri_group_field_count}' colon-separated fields; exactly four fields are required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

IFS=: read -r image_main_user_pri_group _ image_main_user_pri_group_record_id _ <<<"${image_main_user_pri_group_entry}"

if [ -z "${image_main_user_pri_group}" ]; then
    handle_error 1 "The local group with GID '${image_main_user_pri_group_id}' must have a non-empty name. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ "${image_main_user_pri_group_record_id}" != "${image_main_user_pri_group_id}" ]; then
    handle_error 1 "The GID field of primary group '${image_main_user_pri_group}' must use canonical decimal value '${image_main_user_pri_group_id}'; found '${image_main_user_pri_group_record_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# The primary group name must identify only this local group.
image_main_user_group_name_entry_count="$(awk -F: -v name="${image_main_user_pri_group}" '$1 == name { count++ } END { print count + 0 }' /etc/group)" || \
    handle_error 1 "Failed to count local /etc/group entries named '${image_main_user_pri_group}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

if [ "${image_main_user_group_name_entry_count}" -ne 1 ]; then
    handle_error 1 "Primary group name '${image_main_user_pri_group}' is used by '${image_main_user_group_name_entry_count}' local /etc/group entries; exactly one entry is required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# The home path must be absolute and must not be '/'. Allowing '/' would let
# usermod traverse the complete container filesystem when an image has an
# incorrectly configured development account.
if [ -z "${image_main_user_home}" ] || [[ ${image_main_user_home} != /* ]]; then
    handle_error 1 "The home field for '${IMAGE_MAIN_USER}' must contain an absolute path; found '${image_main_user_home}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ "${image_main_user_home}" = / ]; then
    handle_error 1 "The home field for '${IMAGE_MAIN_USER}' must not be '/'; usermod must never traverse the complete container filesystem. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ -L "${image_main_user_home}" ]; then
    handle_error 1 "Home path '${image_main_user_home}' must be a directory, not a symbolic link. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ ! -d "${image_main_user_home}" ]; then
    handle_error 1 "The home field for '${IMAGE_MAIN_USER}' must name an existing directory; found '${image_main_user_home}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# The IMAGE_MAIN_USER_SHELL must be a non-empty string.
if [ -z "${image_main_user_shell}" ]; then
    handle_error 1 "The shell field for '${IMAGE_MAIN_USER}' must not be empty. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# The home directory itself must be owned by
# IMAGE_MAIN_USER_ID:IMAGE_MAIN_USER_PRIMARY_GID.
if ! image_main_user_home_owner="$(stat --format '%u:%g' -- "${image_main_user_home}" 2>/dev/null)"; then
    handle_error 1 "Failed to read the numeric owner and group of home directory '${image_main_user_home}' with stat; expected '${image_main_user_id}:${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

expected_image_main_user_home_owner="${image_main_user_id}:${image_main_user_pri_group_id}"

if [ "${image_main_user_home_owner}" != "${expected_image_main_user_home_owner}" ]; then
    handle_error 1 "Home directory '${image_main_user_home}' belongs to '${image_main_user_home_owner}'; expected IMAGE_MAIN_USER_ID:IMAGE_MAIN_USER_PRIMARY_GID '${expected_image_main_user_home_owner}'. usermod cannot be trusted to traverse this home from the account state found in the image. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# The IMAGE_MAIN_USER_HOME must not be a mount target.
# Mounting the complete home is unsupported because it hides files installed by the image.
if ! command -v findmnt >/dev/null 2>&1; then
    handle_error 1 "Command 'findmnt' is required to determine whether the complete home directory '${image_main_user_home}' is mounted; the command is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if ! mount_targets="$(findmnt --raw --noheadings --output TARGET 2>/dev/null)"; then
    handle_error 1 "Command 'findmnt' failed while listing mount targets needed to check home directory '${image_main_user_home}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

normalized_image_main_user_home="${image_main_user_home}"

while [ "${normalized_image_main_user_home}" != / ] && [[ ${normalized_image_main_user_home} == */ ]]; do
    normalized_image_main_user_home="${normalized_image_main_user_home%/}"
done

if awk -v home="${normalized_image_main_user_home}" '$0 == home { found = 1 } END { exit(found ? 0 : 1) }' <<<"${mount_targets}"; then
    handle_error 1 "Home directory '${image_main_user_home}' is itself a mount target. Mounting the complete home is unsupported because it hides files installed by the image. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# These two image-installed files are required after adaptation. Check both the
# file type and access from IMAGE_MAIN_USER's current numeric identity. A root
# access check alone is insufficient because root can read or execute files that
# the final development user cannot.
if ! command -v setpriv >/dev/null 2>&1; then
    handle_error 1 "Command 'setpriv' is required to validate and start the final development process, but it is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ ! -f "${image_main_user_home}/.entrypoint.sh" ] || [ ! -x "${image_main_user_home}/.entrypoint.sh" ]; then
    handle_error 1 "Required user entrypoint '${image_main_user_home}/.entrypoint.sh' must be a regular executable file. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if ! setpriv --reuid "${image_main_user_id}" --regid "${image_main_user_pri_group_id}" --init-groups \
    /usr/bin/test -x "${image_main_user_home}/.entrypoint.sh"; then
    handle_error 1 "Required user entrypoint '${image_main_user_home}/.entrypoint.sh' must be executable by IMAGE_MAIN_USER '${IMAGE_MAIN_USER}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ ! -f "${image_main_user_home}/.env.rc" ] || [ ! -r "${image_main_user_home}/.env.rc" ]; then
    handle_error 1 "Required environment file '${image_main_user_home}/.env.rc' must be a readable regular file. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if ! setpriv --reuid "${image_main_user_id}" --regid "${image_main_user_pri_group_id}" --init-groups \
    /usr/bin/test -r "${image_main_user_home}/.env.rc"; then
    handle_error 1 "Required environment file '${image_main_user_home}/.env.rc' must be readable by IMAGE_MAIN_USER '${IMAGE_MAIN_USER}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# XDG_RUNTIME_DIR is used only after adaptation, but its value and existing file
# type can be checked now. Rejecting a predictable error here prevents account
# or group changes that would otherwise be followed by a failed startup.
default_xdg_runtime_dir="/run/user/${HOST_UID}"
xdg_runtime_dir="${XDG_RUNTIME_DIR:-${default_xdg_runtime_dir}}"

if [ "${xdg_runtime_dir}" != "${default_xdg_runtime_dir}" ]; then
    handle_error 1 "XDG_RUNTIME_DIR must be '${default_xdg_runtime_dir}'; found '${xdg_runtime_dir}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ -L "${xdg_runtime_dir}" ]; then
    handle_error 1 "XDG_RUNTIME_DIR '${xdg_runtime_dir}' must be a directory, not a symbolic link. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
elif [ -e "${xdg_runtime_dir}" ] && [ ! -d "${xdg_runtime_dir}" ]; then
    handle_error 1 "XDG_RUNTIME_DIR '${xdg_runtime_dir}' exists but is not a directory. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# ---------------------------------------------------------------------------
# Phase 3: validate collisions involving HOST_UID and HOST_UPGID and record the
# required UID, GID, and group-name changes.
#
# The UID collision check deliberately runs before any group command.
# If the value of HOST_UID belongs to another user, the script exits while all
# account and group records still have their original values.
# ---------------------------------------------------------------------------
uid_change_required=false
gid_change_required=false

[ "${HOST_UID}" != "${image_main_user_id}" ] && uid_change_required=true
[ "${HOST_UPGID}" != "${image_main_user_pri_group_id}" ] && gid_change_required=true

host_uid_entry_count="$(awk -F: -v uid="${HOST_UID}" '$3 == uid { count++ } END { print count + 0 }' /etc/passwd)" || \
    handle_error 1 "Failed to count local /etc/passwd entries with requested HOST_UID '${HOST_UID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

# If the uid change is required, the script must ensure that HOST_UID is not already assigned to another user.
# If it is, the script cannot safely change IMAGE_MAIN_USER's UID to HOST_UID because both users
# would then have the same numeric UID, which would give them identical owner permissions on files.
# The script therefore fails before changing any user or group record.
if [ "${uid_change_required}" = true ] && [ "${host_uid_entry_count}" -ne 0 ]; then
    host_uid_names="$(awk -F: -v uid="${HOST_UID}" '$3 == uid { names = names separator $1; separator = ", " } END { print names }' /etc/passwd)" || \
        handle_error 1 "Failed to read local user names with requested HOST_UID '${HOST_UID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    handle_error 1 "Requested HOST_UID '${HOST_UID}' is already used by '${host_uid_entry_count}' local /etc/passwd entry or entries; it must be free before it can be assigned to '${IMAGE_MAIN_USER}'. Conflicting user names: '${host_uid_names}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# usermod refuses to change a UID while that UID owns a running process. Check
# this before group preparation so that a busy user cannot leave renamed groups
# behind without the matching user change.
if [ "${uid_change_required}" = true ]; then
    if ! command -v pgrep >/dev/null 2>&1; then
        handle_error 1 "Command 'pgrep' is required to verify that IMAGE_MAIN_USER_ID '${image_main_user_id}' has no running processes before its UID changes. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi

    if image_main_user_process_ids="$(pgrep --uid "${image_main_user_id}" 2>/dev/null)"; then
        image_main_user_process_ids="$(tr '\n' ' ' <<<"${image_main_user_process_ids}")"
        handle_error 1 "IMAGE_MAIN_USER_ID '${image_main_user_id}' owns one or more running processes (PIDs: ${image_main_user_process_ids% }); usermod refuses to change a busy user's UID. Stop those processes before restarting the container. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    else
        pgrep_status=$?
        if [ "${pgrep_status}" -ne 1 ]; then
            handle_error 1 "Command 'pgrep' failed with status '${pgrep_status}' while checking processes owned by IMAGE_MAIN_USER_ID '${image_main_user_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
        fi
    fi
fi

host_group_entry_count="$(awk -F: -v gid="${HOST_UPGID}" '$3 == gid { count++ } END { print count + 0 }' /etc/group)" || \
    handle_error 1 "Failed to count local /etc/group entries with requested HOST_UPGID '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

# If the gid change is required, the script must ensure that HOST_UPGID is not already assigned to
# multiple groups.
if [ "${host_group_entry_count}" -gt 1 ]; then
    host_group_names="$(awk -F: -v gid="${HOST_UPGID}" '$3 == gid { names = names separator $1; separator = ", " } END { print names }' /etc/group)" || \
        handle_error 1 "Failed to read local group names with requested HOST_UPGID '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    handle_error 1 "Requested HOST_UPGID '${HOST_UPGID}' is shared by '${host_group_entry_count}' local /etc/group entries; zero or one entry is required so the script can determine which group to rename. Conflicting group names: '${host_group_names}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# If the execution flow gets here, then HOST_UID is either free or already assigned to
# IMAGE_MAIN_USER, and HOST_UPGID is either free or assigned to at most one group.
# The script can safely rename the existing group or create a new group with the
# original primary group name of IMAGE_MAIN_USER and HOST_UPGID.

host_group_entry=""
host_group_name=""
preserved_group_name=""

# If exactly one existing group has HOST_UPGID, record its name for later renaming.
if [ "${host_group_entry_count}" -eq 1 ]; then
    host_group_entry="$(awk -F: -v gid="${HOST_UPGID}" '$3 == gid { print; exit }' /etc/group)" || \
        handle_error 1 "Failed to read the local /etc/group entry with requested HOST_UPGID '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    host_group_field_count="$(awk -F: '{ print NF }' <<<"${host_group_entry}")" || \
        handle_error 1 "Failed to count fields in the local /etc/group entry with requested HOST_UPGID '${HOST_UPGID}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

    if [ "${host_group_field_count}" -ne 4 ]; then
        handle_error 1 "The local /etc/group entry with requested HOST_UPGID '${HOST_UPGID}' has '${host_group_field_count}' colon-separated fields; exactly four fields are required. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi

    IFS=: read -r host_group_name _ host_group_record_id _ <<<"${host_group_entry}"

    if [ -z "${host_group_name}" ]; then
        handle_error 1 "The local group with requested HOST_UPGID '${HOST_UPGID}' must have a non-empty name. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi

    if [ "${host_group_record_id}" != "${HOST_UPGID}" ]; then
        handle_error 1 "The GID field of target group '${host_group_name}' must use canonical decimal value '${HOST_UPGID}'; found '${host_group_record_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi

    host_group_name_entry_count="$(awk -F: -v name="${host_group_name}" '$1 == name { count++ } END { print count + 0 }' /etc/group)" || \
        handle_error 1 "Failed to count local /etc/group entries named '${host_group_name}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"

    if [ "${host_group_name_entry_count}" -ne 1 ]; then
        handle_error 1 "Target group name '${host_group_name}' is used by '${host_group_name_entry_count}' local /etc/group entries; exactly one entry is required before that group can be renamed. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi
fi

# groupmod updates /etc/group and /etc/gshadow together. Require one valid
# four-field record with the same name in each file. This check covers every
# group, including the generated rd_old_<GID> namespace, and prevents groupmod
# from silently replacing an orphan /etc/gshadow entry.
if ! awk -F: '
    FILENAME == ARGV[1] {
        if (NF != 4 || $1 == "") invalid = 1
        group_names[$1]++
        next
    }
    FILENAME == ARGV[2] {
        if (NF != 4 || $1 == "") invalid = 1
        gshadow_names[$1]++
        next
    }
    END {
        for (name in group_names) {
            if (group_names[name] != 1 || !(name in gshadow_names) || gshadow_names[name] != 1) invalid = 1
        }
        for (name in gshadow_names) {
            if (gshadow_names[name] != 1 || !(name in group_names) || group_names[name] != 1) invalid = 1
        }
        exit(invalid ? 1 : 0)
    }
' /etc/group /etc/gshadow; then
    handle_error 1 "Local files '/etc/group' and '/etc/gshadow' must contain the same group names, with exactly one four-field entry for each name. Found a missing, duplicate, empty, or malformed group entry. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if [ "${gid_change_required}" = true ]; then
    if ! command -v groupmod >/dev/null 2>&1; then
        handle_error 1 "Command 'groupmod' is required to prepare requested HOST_UPGID '${HOST_UPGID}', but it is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi

    if [ "${host_group_entry_count}" -eq 0 ] && ! command -v groupadd >/dev/null 2>&1; then
        handle_error 1 "Command 'groupadd' is required because requested HOST_UPGID '${HOST_UPGID}' is free, but it is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
    fi

    preserved_group_name="$(generate_preserved_group_name "${image_main_user_pri_group_id}")" || \
        handle_error 1 "Failed to generate a local name for preserving primary GID '${image_main_user_pri_group_id}'. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if { [ "${uid_change_required}" = true ] || [ "${gid_change_required}" = true ]; } && \
    ! command -v usermod >/dev/null 2>&1; then
    handle_error 1 "Command 'usermod' is required to adapt '${IMAGE_MAIN_USER}', but it is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

if ! command -v env >/dev/null 2>&1; then
    handle_error 1 "Command 'env' is required to set the final development environment, but it is not available. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

log info "Initial validation complete: user '${IMAGE_MAIN_USER}' currently has UID '${image_main_user_id}', primary group '${image_main_user_pri_group}' (GID '${image_main_user_pri_group_id}'), and home owner '${image_main_user_home_owner}'"
log info "Requested final identity: UID '${HOST_UID}', primary group '${image_main_user_pri_group}' with GID '${HOST_UPGID}'"

# A missing NVIDIA driver is detectable before account adaptation. Stop here so
# a GPU configuration error cannot leave account records or mounted home content
# changed even though the development process will not start.
if [ "${USE_HOST_NVIDIA_DRIVER}" = "true" ]; then
    nvidia_gpu_driver_check || handle_error 1 "NVIDIA driver validation failed. ${INITIAL_VALIDATION_UNCHANGED_MSG}"
fi

# ---------------------------------------------------------------------------
# Phase 4: ensure that the original primary group name of IMAGE_MAIN_USER is
# associated with HOST_UPGID without changing any existing group's numeric GID.
# ---------------------------------------------------------------------------
if [ "${gid_change_required}" = true ]; then
    log info "Preserving group '${image_main_user_pri_group}' (GID '${image_main_user_pri_group_id}') under name '${preserved_group_name}'"

    if ! groupmod --new-name "${preserved_group_name}" "${image_main_user_pri_group}"; then
        handle_error 1 "Failed to rename group '${image_main_user_pri_group}' (GID '${image_main_user_pri_group_id}') to '${preserved_group_name}'. No later adaptation command was attempted, but inspect /etc/group and /etc/gshadow before restarting because groupmod reported a failure"
    fi

    if [ "${host_group_entry_count}" -eq 0 ]; then
        # Renaming the group associated with IMAGE_MAIN_USER_PRIMARY_GID made
        # the original primary group name available. Creating a group with that
        # name and HOST_UPGID leaves IMAGE_MAIN_USER_PRIMARY_GID and unrelated
        # users unchanged.
        log info "Creating group '${image_main_user_pri_group}' with requested GID '${HOST_UPGID}'"

        if ! groupadd --gid "${HOST_UPGID}" "${image_main_user_pri_group}"; then
            handle_error 1 "Failed to create group '${image_main_user_pri_group}' with GID '${HOST_UPGID}'. The old group was already renamed to '${preserved_group_name}' and still has GID '${image_main_user_pri_group_id}'. No usermod command was attempted. Inspect /etc/group and /etc/gshadow before restarting"
        fi
    else
        # Exactly one existing group has HOST_UPGID. Assigning the original
        # primary group name of IMAGE_MAIN_USER to this group changes only its
        # name; its numeric GID, member list, and file ownership remain unchanged.
        log info "Renaming existing group '${host_group_name}' (GID '${HOST_UPGID}') to '${image_main_user_pri_group}'"

        if ! groupmod --new-name "${image_main_user_pri_group}" "${host_group_name}"; then
            handle_error 1 "Failed to rename group '${host_group_name}' (GID '${HOST_UPGID}') to '${image_main_user_pri_group}'. The old primary group was already renamed to '${preserved_group_name}' and still has GID '${image_main_user_pri_group_id}'. No usermod command was attempted. Inspect /etc/group and /etc/gshadow before restarting"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Phase 5: update IMAGE_MAIN_USER with at most one usermod command.
#
# Passing both options to one usermod command is essential. shadow-utils then
# traverses the home once and independently maps IMAGE_MAIN_USER_ID and
# IMAGE_MAIN_USER_PRIMARY_GID. Running separate usermod commands would traverse
# the home more than once.
# ---------------------------------------------------------------------------
usermod_options=()

if [ "${uid_change_required}" = true ]; then
    usermod_options+=(--uid "${HOST_UID}")
fi

if [ "${gid_change_required}" = true ]; then
    usermod_options+=(--gid "${HOST_UPGID}")
fi

if [ "${uid_change_required}" = false ] && [ "${gid_change_required}" = false ]; then
    log info "UID '${HOST_UID}' and primary GID '${HOST_UPGID}' already match the requested values; usermod will not run and home ownership will not be scanned or repaired"
else
    log info "Running one usermod operation for '${IMAGE_MAIN_USER}' with UID change required='${uid_change_required}' and primary GID change required='${gid_change_required}'"

    if ! usermod "${usermod_options[@]}" "${IMAGE_MAIN_USER}"; then
        if [ "${gid_change_required}" = true ]; then
            handle_error 1 "usermod failed while adapting '${IMAGE_MAIN_USER}' to UID '${HOST_UID}' and primary GID '${HOST_UPGID}'. Group preparation already completed: '${preserved_group_name}' retains GID '${image_main_user_pri_group_id}', and '${image_main_user_pri_group}' has GID '${HOST_UPGID}'. usermod may have updated /etc/passwd and may have changed only part of the home. Inspect the account and home ownership before restarting"
        else
            handle_error 1 "usermod failed while adapting '${IMAGE_MAIN_USER}' from UID '${image_main_user_id}' to UID '${HOST_UID}'. usermod may have updated /etc/passwd and may have changed only part of the home. Inspect the account and home ownership before restarting"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Phase 6: verify final state without recursively scanning the home.
# ---------------------------------------------------------------------------
final_user_entry_count="$(awk -F: -v user="${IMAGE_MAIN_USER}" '$1 == user { count++ } END { print count + 0 }' /etc/passwd)" || \
    handle_error 1 "Postcondition failed: could not count local /etc/passwd entries named '${IMAGE_MAIN_USER}'. UID/GID adaptation commands have already run; inspect the account databases and home before restarting"

if [ "${final_user_entry_count}" -ne 1 ]; then
    handle_error 1 "Postcondition failed: local file '/etc/passwd' contains '${final_user_entry_count}' entries named '${IMAGE_MAIN_USER}'; expected exactly one. UID/GID adaptation commands have already run; inspect the account databases and home before restarting"
fi

final_user_entry="$(awk -F: -v user="${IMAGE_MAIN_USER}" '$1 == user { print; exit }' /etc/passwd)" || \
    handle_error 1 "Postcondition failed: could not read the local /etc/passwd entry named '${IMAGE_MAIN_USER}'. UID/GID adaptation commands have already run; inspect the account databases and home before restarting"
final_user_id="$(awk -F: '{ print $3 }' <<<"${final_user_entry}")" || \
    handle_error 1 "Postcondition failed: could not read the final UID of '${IMAGE_MAIN_USER}'. UID/GID adaptation commands have already run; inspect the account databases and home before restarting"
final_user_pri_group_id="$(awk -F: '{ print $4 }' <<<"${final_user_entry}")" || \
    handle_error 1 "Postcondition failed: could not read the final primary GID of '${IMAGE_MAIN_USER}'. UID/GID adaptation commands have already run; inspect the account databases and home before restarting"

if [ "${final_user_id}" != "${HOST_UID}" ] || [ "${final_user_pri_group_id}" != "${HOST_UPGID}" ]; then
    handle_error 1 "Postcondition failed: '${IMAGE_MAIN_USER}' has UID:GID '${final_user_id}:${final_user_pri_group_id}'; expected '${HOST_UID}:${HOST_UPGID}'. Adaptation commands have already run; inspect the account databases and home before restarting"
fi

final_primary_group_entry_count="$(awk -F: -v name="${image_main_user_pri_group}" '$1 == name { count++ } END { print count + 0 }' /etc/group)" || \
    handle_error 1 "Postcondition failed: could not count local /etc/group entries named '${image_main_user_pri_group}'. Group preparation has already run; inspect /etc/group and /etc/gshadow before restarting"
final_primary_group_entry="$(awk -F: -v name="${image_main_user_pri_group}" '$1 == name { print; exit }' /etc/group)" || \
    handle_error 1 "Postcondition failed: could not read the local /etc/group entry named '${image_main_user_pri_group}'. Group preparation has already run; inspect /etc/group and /etc/gshadow before restarting"
final_primary_group_id="$(awk -F: '{ print $3 }' <<<"${final_primary_group_entry}")" || \
    handle_error 1 "Postcondition failed: could not read the GID of final primary group '${image_main_user_pri_group}'. Group preparation has already run; inspect /etc/group and /etc/gshadow before restarting"

if [ "${final_primary_group_entry_count}" -ne 1 ] || [ "${final_primary_group_id}" != "${HOST_UPGID}" ]; then
    handle_error 1 "Postcondition failed: expected exactly one local group named '${image_main_user_pri_group}' with GID '${HOST_UPGID}', but found count='${final_primary_group_entry_count}' and GID='${final_primary_group_id}'. Group preparation has already run; inspect /etc/group and /etc/gshadow before restarting"
fi

final_primary_group_gshadow_entry_count="$(awk -F: -v name="${image_main_user_pri_group}" '$1 == name { count++ } END { print count + 0 }' /etc/gshadow)" || \
    handle_error 1 "Postcondition failed: could not count local /etc/gshadow entries named '${image_main_user_pri_group}'. Group preparation has already run; inspect /etc/group and /etc/gshadow before restarting"

if [ "${final_primary_group_gshadow_entry_count}" -ne 1 ]; then
    handle_error 1 "Postcondition failed: expected exactly one local /etc/gshadow entry named '${image_main_user_pri_group}', but found '${final_primary_group_gshadow_entry_count}'. Group preparation has already run; inspect /etc/group and /etc/gshadow before restarting"
fi

if ! final_home_owner="$(stat --format '%u:%g' -- "${image_main_user_home}" 2>/dev/null)"; then
    handle_error 1 "Postcondition failed: stat could not read final ownership of home directory '${image_main_user_home}'. Adaptation commands have already run; inspect the account and home before restarting"
fi

if [ "${final_home_owner}" != "${HOST_UID}:${HOST_UPGID}" ]; then
    handle_error 1 "Postcondition failed: home directory '${image_main_user_home}' belongs to '${final_home_owner}'; expected '${HOST_UID}:${HOST_UPGID}'. usermod may have skipped or only partly completed its home traversal. Inspect the account and home before restarting"
fi

if [ "${gid_change_required}" = true ]; then
    preserved_group_entry_count="$(awk -F: -v name="${preserved_group_name}" '$1 == name { count++ } END { print count + 0 }' /etc/group)" || \
        handle_error 1 "Postcondition failed: could not count local /etc/group entries named '${preserved_group_name}'. Inspect /etc/group and /etc/gshadow before restarting"
    preserved_group_entry="$(awk -F: -v name="${preserved_group_name}" '$1 == name { print; exit }' /etc/group)" || \
        handle_error 1 "Postcondition failed: could not read preserved group '${preserved_group_name}'. Inspect /etc/group and /etc/gshadow before restarting"
    preserved_group_id="$(awk -F: '{ print $3 }' <<<"${preserved_group_entry}")" || \
        handle_error 1 "Postcondition failed: could not read the GID of preserved group '${preserved_group_name}'. Inspect /etc/group and /etc/gshadow before restarting"

    if [ "${preserved_group_entry_count}" -ne 1 ] || [ "${preserved_group_id}" != "${image_main_user_pri_group_id}" ]; then
        handle_error 1 "Postcondition failed: preserved group '${preserved_group_name}' must appear once with old GID '${image_main_user_pri_group_id}', but found count='${preserved_group_entry_count}' and GID='${preserved_group_id}'. Inspect /etc/group and /etc/gshadow before restarting"
    fi


    preserved_group_gshadow_entry_count="$(awk -F: -v name="${preserved_group_name}" '$1 == name { count++ } END { print count + 0 }' /etc/gshadow)" || \
        handle_error 1 "Postcondition failed: could not count local /etc/gshadow entries named '${preserved_group_name}'. Inspect /etc/group and /etc/gshadow before restarting"

    if [ "${preserved_group_gshadow_entry_count}" -ne 1 ]; then
        handle_error 1 "Postcondition failed: expected exactly one local /etc/gshadow entry named '${preserved_group_name}', but found '${preserved_group_gshadow_entry_count}'. Inspect /etc/group and /etc/gshadow before restarting"
    fi
fi

image_main_user_entry="${final_user_entry}"
image_main_user_id="${final_user_id}"
image_main_user_pri_group_id="${final_user_pri_group_id}"

log success "UID/GID adaptation complete: user '${IMAGE_MAIN_USER}' has UID '${image_main_user_id}', primary group '${image_main_user_pri_group}' (GID '${image_main_user_pri_group_id}'), and home owner '${final_home_owner}'"

# Run root hooks from /etc/entrypoint.d, if any.
# A hook is an optional project script that runs at a defined point during startup.
# These hooks run as root after UID/GID adaptation and before setpriv starts the
# final development process.
root_hooks_dir="/etc/entrypoint.d"
run_root_entrypoint_hooks "${root_hooks_dir}"

# Set XDG_RUNTIME_DIR.
# XDG_RUNTIME_DIR is a per-user runtime directory for storing non-essential, non-persistent files such as sockets,
# named pipes, and temporary files.

# Repeat the file-type check immediately before changing XDG_RUNTIME_DIR. The
# earlier validation catches the initial state; this check protects against the
# path being replaced while the entrypoint is running.
if [ -L "${xdg_runtime_dir}" ]; then
    handle_error 1 "XDG_RUNTIME_DIR '${xdg_runtime_dir}' must be a directory, not a symbolic link"
elif [ -e "${xdg_runtime_dir}" ] && [ ! -d "${xdg_runtime_dir}" ]; then
    handle_error 1 "XDG_RUNTIME_DIR '${xdg_runtime_dir}' exists but is not a directory"
elif [ ! -d "${xdg_runtime_dir}" ]; then
    log info "Creating directory '${xdg_runtime_dir}'"
    install --directory --mode 700 --owner "${HOST_UID}" --group "${HOST_UPGID}" "${xdg_runtime_dir}" || handle_error 1 "Failed to create directory '${xdg_runtime_dir}'"
else
    log info "Directory '${xdg_runtime_dir}' already exists"
    chown -h "${HOST_UID}:${HOST_UPGID}" "${xdg_runtime_dir}" || handle_error 1 "Failed to set ownership of directory '${xdg_runtime_dir}'"
    chmod 700 "${xdg_runtime_dir}" || handle_error 1 "Failed to set mode '700' on directory '${xdg_runtime_dir}'"
fi

# Docker applies group_add to the root entrypoint process. Tools such as gosu
# replace that process group list with the groups found for IMAGE_MAIN_USER in
# /etc/group, which silently removes numeric groups added only by Docker. Build
# the union explicitly before dropping privileges:
#   * image_main_user_group_ids contains groups recorded for IMAGE_MAIN_USER;
#   * entrypoint_group_ids contains numeric groups inherited from Docker;
#   * IMAGE_MAIN_USER's final primary GID and the entrypoint's primary GID are
#     excluded from the supplementary list;
#   * repeated GIDs are included once.
if ! image_main_user_group_ids="$(id --groups "${IMAGE_MAIN_USER}" 2>/dev/null)"; then
    handle_error 1 "Failed to read the final group list recorded for '${IMAGE_MAIN_USER}'"
fi

if ! entrypoint_group_ids="$(id --groups 2>/dev/null)"; then
    handle_error 1 "Failed to read the numeric groups inherited by the entrypoint process"
fi

final_supplementary_group_ids="$(
    awk -v final_primary_group_id="${HOST_UPGID}" -v entrypoint_primary_group_id="${entrypoint_primary_group_id}" '
        {
            for (field = 1; field <= NF; field++) {
                group_id = $field
                if (group_id == final_primary_group_id || group_id == entrypoint_primary_group_id) {
                    continue
                }
                if (!seen[group_id]++) {
                    groups = groups separator group_id
                    separator = ","
                }
            }
        }
        END { print groups }
    ' <<<"${image_main_user_group_ids} ${entrypoint_group_ids}"
)" || handle_error 1 "Failed to build the final supplementary group list for '${IMAGE_MAIN_USER}'"

setpriv_options=(--reuid "${HOST_UID}" --regid "${HOST_UPGID}")

if [ -n "${final_supplementary_group_ids}" ]; then
    setpriv_options+=(--groups "${final_supplementary_group_ids}")
else
    setpriv_options+=(--clear-groups)
fi

log info "Starting '${IMAGE_MAIN_USER}' with UID '${HOST_UID}', primary GID '${HOST_UPGID}', and supplementary GIDs '${final_supplementary_group_ids:-none}'"

# setpriv changes the process IDs but does not initialize login environment
# variables. Set them explicitly so the final process uses IMAGE_MAIN_USER's
# home and shell instead of root's values.
exec setpriv "${setpriv_options[@]}" env \
    HOME="${image_main_user_home}" \
    USER="${IMAGE_MAIN_USER}" \
    LOGNAME="${IMAGE_MAIN_USER}" \
    SHELL="${image_main_user_shell}" \
    XDG_RUNTIME_DIR="${xdg_runtime_dir}" \
    "${image_main_user_home}/.entrypoint.sh" \
    "$@"
