# syntax=docker/dockerfile:1

FROM {{ base_img }}

# These OCI labels describe the generated project. They are chosen when
# robotics-dockers new creates this Dockerfile. build.py adds only the creation
# timestamp because that value belongs to the later build operation.
LABEL org.opencontainers.image.title={{ meta_title | tojson }} \
    org.opencontainers.image.description={{ meta_desc | tojson }} \
    org.opencontainers.image.authors={{ meta_authors | tojson }}

ARG DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO="{{ ros_distro }}" \
    ROS_VERSION="2" \
    USE_HOST_NVIDIA_DRIVER="{{ use_host_nvidia_driver | lower }}"

USER root
WORKDIR /root
SHELL ["/bin/bash", "-c"]

# BuildKit includes files used by RUN --mount=type=bind in the cache key. A
# changed mounted file therefore invalidates this RUN even though an ordinary RUN
# is normally matched from its instruction text. The mounted files are temporary:
# they are not stored in the final image or in a resource layer. robotics-dockers
# consequently does not implement a second checksum mechanism.
# Reference: https://docs.docker.com/build/cache/invalidation/
RUN --mount=type=bind,source=.resources/install_pkgs,target=/tmp/install_pkgs,readonly \
    --mount=type=bind,source=.resources/install_base_system.sh,target=/tmp/install_base_system.sh,readonly <<'EOF'
install --owner root --group root --mode 0755 /tmp/install_pkgs /usr/local/bin/install_pkgs || {
    echo "Error: could not install /usr/local/bin/install_pkgs" >&2
    exit 1
}
bash /tmp/install_base_system.sh || {
    echo "Error: base-system installation failed" >&2
    exit 1
}
EOF

{% if not use_host_nvidia_driver %}
RUN --mount=type=bind,source=.resources/install_mesa_packages.sh,target=/tmp/install_mesa_packages.sh,readonly \
    bash /tmp/install_mesa_packages.sh || { echo "Error: Mesa package installation failed" >&2; exit 1; }
{% endif %}

RUN --mount=type=bind,source=.resources/install_gh.sh,target=/tmp/install_gh.sh,readonly \
    bash /tmp/install_gh.sh || { echo "Error: GitHub CLI installation failed" >&2; exit 1; }

RUN --mount=type=bind,source=.resources/install_ros.sh,target=/tmp/install_ros.sh,readonly \
    --mount=type=bind,source=.resources/skip_rosdep_keys,target=/tmp/skip_rosdep_keys,readonly \
    --mount=type=bind,source=.resources/rosdep_skip_keys.txt,target=/tmp/rosdep_skip_keys.txt,readonly <<'EOF'
install --owner root --group root --mode 0755 /tmp/skip_rosdep_keys /usr/local/bin/skip_rosdep_keys || {
    echo "Error: could not install skip_rosdep_keys" >&2
    exit 1
}
bash /tmp/install_ros.sh "${ROS_DISTRO}" || {
    echo "Error: ROS installation failed" >&2
    exit 1
}
skip_rosdep_keys /tmp/rosdep_skip_keys.txt || {
    echo "Error: rosdep skip-key configuration failed" >&2
    exit 1
}
EOF

# Apt customizations are intentionally later than the expensive common ROS
# installation. Editing packages.txt or a project repository rebuilds this phase
# and the user-specific phases, but retains the common system layers.
RUN --mount=type=bind,source=.resources/install_extra_apt.sh,target=/tmp/install_extra_apt.sh,readonly \
    --mount=type=bind,source=.resources/extra.d/apt,target=/tmp/extra_d_apt,readonly <<'EOF'
bash /tmp/install_extra_apt.sh /tmp/extra_d_apt || {
    echo "Error: extra apt installation failed" >&2
    exit 1
}
EOF

# The development identity is placed after common package layers so changing a
# name or numeric identifier can reuse those layers. No defaults are provided:
# build.py validates and supplies every value, while a direct docker build must
# provide the same complete contract explicitly.
ARG ROBOTICS_DOCKERS_USER
ARG ROBOTICS_DOCKERS_USER_ID
ARG ROBOTICS_DOCKERS_USER_HOME
ARG ROBOTICS_DOCKERS_USER_PRIMARY_GROUP
ARG ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID

# ARG values disappear after the build stage. ENV keeps the final identity
# available to the entrypoint, derived images and inspection tools.
ENV ROBOTICS_DOCKERS_USER="${ROBOTICS_DOCKERS_USER}" \
    ROBOTICS_DOCKERS_USER_ID="${ROBOTICS_DOCKERS_USER_ID}" \
    ROBOTICS_DOCKERS_USER_HOME="${ROBOTICS_DOCKERS_USER_HOME}" \
    ROBOTICS_DOCKERS_USER_PRIMARY_GROUP="${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP}" \
    ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID="${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}"

LABEL io.github.jfrascon.robotics-dockers.user.name="${ROBOTICS_DOCKERS_USER}" \
    io.github.jfrascon.robotics-dockers.user.id="${ROBOTICS_DOCKERS_USER_ID}" \
    io.github.jfrascon.robotics-dockers.user.home="${ROBOTICS_DOCKERS_USER_HOME}" \
    io.github.jfrascon.robotics-dockers.user.primary-group.name="${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP}" \
    io.github.jfrascon.robotics-dockers.user.primary-group.id="${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}"

# Preparation hooks are an explicit escape hatch for known base-image accounts.
# They run as root before any project identity is created. Only regular .sh files
# are active; .example files remain documentation until deliberately renamed.
RUN --mount=type=bind,source=.resources/user_preparation.d,target=/tmp/user_preparation.d,readonly \
    --mount=type=bind,source=.resources/configure_image_user.sh,target=/tmp/configure_image_user.sh,readonly <<'EOF'
if find /tmp/user_preparation.d -type l -print -quit | grep -q .; then
    echo "Error: symbolic links are not allowed in user_preparation.d" >&2
    exit 1
fi
while IFS= read -r -d '' preparation_hook; do
    # ${preparation_hook##*/} removes the directory prefix and leaves the hook
    # filename for the human-readable build log.
    echo "Running user preparation hook '${preparation_hook##*/}'"
    bash "${preparation_hook}" || {
        echo "Error: user preparation hook '${preparation_hook}' failed" >&2
        exit 1
    }
done < <(find /tmp/user_preparation.d -maxdepth 1 -type f -name '*.sh' -print0 | LC_ALL=C sort -z)

bash /tmp/configure_image_user.sh \
    "${ROBOTICS_DOCKERS_USER}" \
    "${ROBOTICS_DOCKERS_USER_ID}" \
    "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP}" \
    "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
    "${ROBOTICS_DOCKERS_USER_HOME}" || {
        echo "Error: development identity configuration failed" >&2
        exit 1
    }
EOF

# rosdep and colcon create data that belongs in the configured home, so these
# phases run only after that account has been validated.
RUN --mount=type=bind,source=.resources/rosdep_init_update_install.sh,target=/tmp/rosdep_init_update_install.sh,readonly \
    --mount=type=bind,from=pkgs,target=/tmp/pkgs_dir,readonly <<'EOF'
bash /tmp/rosdep_init_update_install.sh \
    "${ROS_DISTRO}" "${ROBOTICS_DOCKERS_USER}" --pkgs-dir /tmp/pkgs_dir || {
    echo "Error: rosdep setup or dependency installation failed" >&2
    exit 1
}
EOF

RUN --mount=type=bind,source=.resources/colcon_mixin_metadata.sh,target=/tmp/colcon_mixin_metadata.sh,readonly <<'EOF'
bash /tmp/colcon_mixin_metadata.sh "${ROBOTICS_DOCKERS_USER}" || {
    echo "Error: colcon mixin or metadata setup failed" >&2
    exit 1
}
EOF

# Install runtime files individually with their final ownership. No recursive
# ownership repair is needed, so large pre-existing homes are not scanned.
RUN --mount=type=bind,source=.resources/bashrc_user,target=/tmp/bashrc_user,readonly \
    --mount=type=bind,source=.resources/bash_aliases_user,target=/tmp/bash_aliases_user,readonly \
    --mount=type=bind,source=.resources/entrypoint_user.sh,target=/tmp/entrypoint_user.sh,readonly \
    --mount=type=bind,source=.resources/env.rc,target=/tmp/env.rc,readonly \
    --mount=type=bind,source=.resources/ros.rc,target=/tmp/ros.rc,readonly \
    --mount=type=bind,source=.resources/rosbuild,target=/tmp/rosbuild,readonly \
    --mount=type=bind,source=.resources/extra.d/env.d,target=/tmp/environment-hooks,readonly <<'EOF'
if [ ! -s "${ROBOTICS_DOCKERS_USER_HOME}/.bashrc" ]; then
    install --owner "${ROBOTICS_DOCKERS_USER_ID}" --group "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
        --mode 0644 /etc/skel/.bashrc "${ROBOTICS_DOCKERS_USER_HOME}/.bashrc" || exit 1
fi
install --owner "${ROBOTICS_DOCKERS_USER_ID}" --group "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
    --mode 0644 /tmp/bashrc_user "${ROBOTICS_DOCKERS_USER_HOME}/.bashrc_user" || exit 1
bashrc_loader_marker='# Load the robotics-dockers interactive Bash configuration.'
if ! grep -qxF "${bashrc_loader_marker}" "${ROBOTICS_DOCKERS_USER_HOME}/.bashrc"; then
    printf '\n%s\nif [ -f "${HOME}/.bashrc_user" ]; then\n    . "${HOME}/.bashrc_user"\nfi\n' \
        "${bashrc_loader_marker}" >>"${ROBOTICS_DOCKERS_USER_HOME}/.bashrc" || exit 1
fi
install --owner "${ROBOTICS_DOCKERS_USER_ID}" --group "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
    --mode 0644 /tmp/bash_aliases_user "${ROBOTICS_DOCKERS_USER_HOME}/.bash_aliases_user" || exit 1
install --owner "${ROBOTICS_DOCKERS_USER_ID}" --group "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
    --mode 0644 /tmp/env.rc "${ROBOTICS_DOCKERS_USER_HOME}/.env.rc" || exit 1
install --owner "${ROBOTICS_DOCKERS_USER_ID}" --group "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
    --mode 0644 /tmp/ros.rc "${ROBOTICS_DOCKERS_USER_HOME}/.ros.rc" || exit 1
install --owner root --group root --mode 0755 /tmp/entrypoint_user.sh /usr/local/bin/entrypoint.sh || exit 1
install --owner root --group root --mode 0755 /tmp/rosbuild /usr/local/bin/rosbuild || exit 1

if find /tmp/environment-hooks -type l -print -quit | grep -q .; then
    echo "Error: symbolic links are not allowed in extra.d/env.d" >&2
    exit 1
fi
while IFS= read -r -d '' environment_hook; do
    # ${environment_hook##*/} removes the directory prefix and leaves the hook
    # filename used at the destination.
    install --owner "${ROBOTICS_DOCKERS_USER_ID}" --group "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}" \
        --mode 0644 "${environment_hook}" "${ROBOTICS_DOCKERS_USER_HOME}/.env.d/${environment_hook##*/}" || exit 1
done < <(find /tmp/environment-hooks -maxdepth 1 -type f -name '*.rc' -print0 | LC_ALL=C sort -z)
EOF

# User extras run as the real account, not through sudo -u. The project sudo
# rule is installed only after this phase succeeds.
USER "${ROBOTICS_DOCKERS_USER}"
RUN --mount=type=bind,source=.resources/install_user_extras.sh,target=/tmp/install_user_extras.sh,readonly \
    --mount=type=bind,source=.resources/extra.d/python,target=/tmp/extra/python,readonly \
    --mount=type=bind,source=.resources/extra.d/rust,target=/tmp/extra/rust,readonly \
    HOME="${ROBOTICS_DOCKERS_USER_HOME}" \
    PATH="${ROBOTICS_DOCKERS_USER_HOME}/.local/bin:${PATH}" \
    bash /tmp/install_user_extras.sh /tmp/extra

USER root
RUN --mount=type=bind,source=.resources/configure_sudo.sh,target=/tmp/configure_sudo.sh,readonly \
    bash /tmp/configure_sudo.sh "${ROBOTICS_DOCKERS_USER}"

# General runtime defaults are safe for root and alternate users. Values that
# contain the development home are set by .ros.rc only in the matching-user path.
ENV TZ="Etc/UTC" \
    LC_ALL="en_US.UTF-8" \
    LANG="en_US.UTF-8" \
    LANGUAGE="en_US:en" \
    RTI_NC_LICENSE_ACCEPTED="no" \
    RCUTILS_COLORIZED_OUTPUT="1" \
    RCUTILS_LOGGING_USE_STDOUT="1" \
    RCUTILS_LOGGING_BUFFERED_STREAM="1" \
    RCUTILS_CONSOLE_OUTPUT_FORMAT="[{severity}] {time} {name}: {message}" \
    ROS_DOMAIN_ID="0" \
    {{ ros_discovery_env_name }}={{ ros_discovery_env_value | tojson }} \
    RMW_IMPLEMENTATION="rmw_fastrtps_cpp"

USER "${ROBOTICS_DOCKERS_USER}"
WORKDIR "${ROBOTICS_DOCKERS_USER_HOME}"
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
