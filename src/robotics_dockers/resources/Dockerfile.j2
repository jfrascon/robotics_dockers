# syntax=docker/dockerfile:1

# No default base_img is provided to ensure the build process fails if no base_img is specified.
# The warning 'InvalidDefaultArgInFrom: Default value for ARG ${base_img} results in empty or
# invalid base image name' can be safely ignored, as this behavior is intentional.
FROM {{ base_img }}

# The following labels adhere to the OCI Image Specification for standardized metadata.
# Reference: https://github.com/opencontainers/image-spec/blob/main/annotations.md
LABEL org.opencontainers.image.title={{ meta_title | tojson }} \
    org.opencontainers.image.description={{ meta_desc | tojson }} \
    org.opencontainers.image.authors={{ meta_authors | tojson }}

# Build-time configuration variables.
# These are set early so they are available to all RUN steps during the build.
ENV IMAGE_MAIN_USER="{{ image_main_user }}" \
    IMAGE_MAIN_USER_HOME="{{ image_main_user_home }}" \
    ROS_DISTRO="{{ ros_distro }}" \
    ROS_VERSION="2" \
    USE_HOST_NVIDIA_DRIVER="{{ use_host_nvidia_driver | lower }}" \
    DEBIAN_FRONTEND="noninteractive"

USER root
WORKDIR /root

SHELL ["/bin/bash", "-c"]

# Validate the required files from the build context before running installation steps.
# This makes the build fail early when a required file is missing, instead of failing after
# expensive package installation work has already completed.
RUN --mount=type=bind,source=.,target=/tmp/context <<'EOF'
log() { echo "[$(date --utc '+%Y-%m-%dT%H:%M:%SZ')]" "$@"; }
handle_error() { log "Error: ${2:-Unknown error}" >&2; exit "${1:-1}"; }

context_dir="/tmp/context"
required_context_paths=(
    .resources/bashrc.user
    .resources/install_pkgs
    .resources/install_base_system.sh
{% if not use_host_nvidia_driver %}
    .resources/install_mesa_packages.sh
{% endif %}
    .resources/install_gh.sh
    .resources/install_ros.sh
    .resources/install_extra_pkgs.sh
    .resources/deduplicate_path
    .resources/entrypoint.sh
    .resources/skip_rosdep_keys
    .resources/rosdep_skip_keys.txt
    .resources/rosbuild
    .resources/rosdep_init_update_install.sh
    .resources/colcon_mixin_metadata.sh
)

for relative_path in "${required_context_paths[@]}"; do
    if [ ! -f "${context_dir}/${relative_path}" ]; then
        handle_error 1 "File not found: ${context_dir}/${relative_path}"
    fi
done

if [ ! -d "${context_dir}/.resources/entrypoint.d" ]; then
    handle_error 1 "Directory not found: ${context_dir}/.resources/entrypoint.d"
fi
EOF

# Configure apt network timeouts and retries so slow mirrors fail instead of hanging indefinitely.
RUN tee /etc/apt/apt.conf.d/99timeouts.conf >/dev/null <<'EOF'
Acquire::http::Timeout "30";
Acquire::https::Timeout "30";
Acquire::ftp::Timeout "30";
Acquire::Retries "3";
EOF

# Avoid installing recommended and suggested packages.
RUN tee /etc/apt/apt.conf.d/99norecommends.conf >/dev/null <<'EOF'
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF

# Install skip_rosdep_keys globally so it can be called from extra.d/apt_packages.sh.
COPY --chmod=755 .resources/skip_rosdep_keys /usr/local/bin/skip_rosdep_keys

RUN --mount=type=bind,source=.resources,target=/tmp/context/.resources \
    --mount=type=bind,from=pkgs,target=/tmp/pkgs_dir <<'EOF'
log() { echo "[$(date --utc '+%Y-%m-%dT%H:%M:%SZ')]" "$@"; }
handle_error() { log "Error: ${2:-Unknown error}" >&2; exit "${1:-1}"; }

install --owner root --group root --mode 775 /tmp/context/.resources/install_pkgs /usr/local/bin/install_pkgs || \
    handle_error 1 "Failed to install 'install_pkgs'"

bash /tmp/context/.resources/install_base_system.sh "${IMAGE_MAIN_USER}" "${IMAGE_MAIN_USER_HOME}" || \
    handle_error 1 "Failed to run 'install_base_system.sh'"

# Verify IMAGE_MAIN_USER exists in the system.
image_main_user_entry="$(getent passwd "${IMAGE_MAIN_USER}")"
[ -z "${image_main_user_entry}" ] && handle_error 1 "User '${IMAGE_MAIN_USER}' not found"

{% if not use_host_nvidia_driver %}
bash /tmp/context/.resources/install_mesa_packages.sh || \
    handle_error 1 "Failed to run 'install_mesa_packages.sh'"

{% endif %}
bash /tmp/context/.resources/install_ros.sh "${ROS_DISTRO}" || \
    handle_error 1 "Failed to run 'install_ros.sh'"

# No ROS_DISTRO found at this point, exit with an error.
# If more than one ROS_DISTRO is found, exit with an error.
# If the found ROS_DISTRO does not match the expected ROS_DISTRO, exit with an error.
ros_distro="$(dpkg --list | sed -nE 's/^ii\s+ros-([a-z]+)-ros-core.*$/\1/p' | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
num_distros="$(echo "${ros_distro}" | wc -w)"

[ "${num_distros}" -eq 0 ] && handle_error 1 "No ROS distribution found"
[ "${num_distros}" -gt 1 ] && handle_error 1 "More than one ROS_DISTRO found: ${ros_distro}"
[ "${ROS_DISTRO}" != "${ros_distro}" ] && handle_error 1 "Found ROS_DISTRO '${ros_distro}', expected ROS_DISTRO '${ROS_DISTRO}'"

bash /usr/local/bin/skip_rosdep_keys /tmp/context/.resources/rosdep_skip_keys.txt || \
    handle_error 1 "Failed to run 'skip_rosdep_keys'"

bash /tmp/context/.resources/install_extra_pkgs.sh "${IMAGE_MAIN_USER}" "${IMAGE_MAIN_USER_HOME}" || \
    handle_error 1 "Failed to run 'install_extra_pkgs.sh'"

bash /tmp/context/.resources/rosdep_init_update_install.sh \
    "${ROS_DISTRO}" "${IMAGE_MAIN_USER}" --pkgs-dir /tmp/pkgs_dir || \
    handle_error 1 "Failed to run 'rosdep_init_update_install.sh'"

bash /tmp/context/.resources/colcon_mixin_metadata.sh "${IMAGE_MAIN_USER}" || \
    handle_error 1 "Failed to run 'colcon_mixin_metadata.sh'"

bash /tmp/context/.resources/install_gh.sh || \
    handle_error 1 "Failed to run 'install_gh.sh'"

image_main_user_id="$(echo "${image_main_user_entry}" | cut -d: -f3)"
image_main_user_pri_group_id="$(echo "${image_main_user_entry}" | cut -d: -f4)"
image_main_user_pri_group="$(getent group "${image_main_user_pri_group_id}" | cut -d: -f1)"

# If the '${bashrc_user_line}' does not exist in the .bashrc file of the user, added it.
bashrc_user_line='[ -f "${HOME}/.bashrc.user" ] && . "${HOME}/.bashrc.user"'

# -q, --quiet: Suppress normal output.
# -x, --line-regexp: Select only those matches that exactly match the whole line.
# -F, --fixed-strings: Interpret the pattern as fixed strings, not regular expressions.
if ! grep -qxF "${bashrc_user_line}" "${IMAGE_MAIN_USER_HOME}/.bashrc"; then
    log "Adding line '${bashrc_user_line}' to file the '${IMAGE_MAIN_USER_HOME}/.bashrc'"
    echo '# --------------------------------------' >> "${IMAGE_MAIN_USER_HOME}/.bashrc"
    echo "${bashrc_user_line}" >> "${IMAGE_MAIN_USER_HOME}/.bashrc"
else
    log "Line '${bashrc_user_line}' already exists in file '${IMAGE_MAIN_USER_HOME}/.bashrc'"
fi

# An environment script is installed in the home directory of the '${IMAGE_MAIN_USER}'.
log "Installing file '${IMAGE_MAIN_USER_HOME}/.bashrc.user'"
install --owner "${IMAGE_MAIN_USER}" --group "${image_main_user_pri_group}" --mode 664 /tmp/context/.resources/bashrc.user "${IMAGE_MAIN_USER_HOME}/.bashrc.user"

# Every file and folder in image_main_user_home must belong to the IMAGE_MAIN_USER.
log "Setting ownership of path '${IMAGE_MAIN_USER_HOME}' to user '${IMAGE_MAIN_USER}' (UID '${image_main_user_id}') and primary group '${image_main_user_pri_group}' (GID '${image_main_user_pri_group_id}')"
chown --recursive "${IMAGE_MAIN_USER}":"${image_main_user_pri_group}" "${IMAGE_MAIN_USER_HOME}"

log "Installing file '/usr/local/bin/entrypoint.sh'"
install --owner root --group root --mode 775 /tmp/context/.resources/entrypoint.sh /usr/local/bin/entrypoint.sh

log "Installing root hook scripts to /etc/entrypoint.d/"
mkdir --parent /etc/entrypoint.d
while IFS= read -r -d '' hook_path; do
    hook_name="$(basename "${hook_path}")"
    hook_mode="775"

    if [[ ${hook_path} == *.txt ]]; then
        hook_mode="664"
    fi

    log "Installing root hook '/etc/entrypoint.d/${hook_name}'"
    install --owner root --group root --mode "${hook_mode}" "${hook_path}" "/etc/entrypoint.d/${hook_name}"
done < <(find /tmp/context/.resources/entrypoint.d -maxdepth 1 -type f \( -name '*.sh' -o -name '*.txt' \) -print0 | sort -z)

log "Installing file '${IMAGE_MAIN_USER_HOME}/.local/bin/deduplicate_path'"
install --owner "${IMAGE_MAIN_USER}" --group "${image_main_user_pri_group}" --mode 775 /tmp/context/.resources/deduplicate_path "${IMAGE_MAIN_USER_HOME}/.local/bin/deduplicate_path"

log "Installing file '/usr/local/bin/rosbuild'"
install --owner root --group root --mode 775 /tmp/context/.resources/rosbuild /usr/local/bin/rosbuild

# Install .bash_aliases.user if present in context (the user may have removed it between create_docker_files.py and build.py).
if [ -e /tmp/context/.resources/bash_aliases.user ]; then
    log "Installing file '${IMAGE_MAIN_USER_HOME}/.bash_aliases.user'"
    install --owner "${IMAGE_MAIN_USER}" --group "${image_main_user_pri_group}" --mode 664 /tmp/context/.resources/bash_aliases.user "${IMAGE_MAIN_USER_HOME}/.bash_aliases.user"
fi

log "Removing installation residues from apt cache"
apt-get autoremove --purge -y >/dev/null
apt-get clean >/dev/null
rm -rf /var/lib/apt/lists/* &>/dev/null
EOF

# Runtime environment variables.
# Set after all installation steps to avoid interfering with package configuration
# (e.g. tzdata reads TZ during installation if set beforehand).
# Items available for RCUTILS_CONSOLE_OUTPUT_FORMAT:
# [{severity} {time}] [{name}]: {message} ({function_name}() at {file_name}:{line_number})
ENV TZ="Etc/UTC" \
    LC_ALL="en_US.UTF-8" \
    LANG="en_US.UTF-8" \
    LANGUAGE="en_US:en" \
    ROS_HOME="${IMAGE_MAIN_USER_HOME}/.ros" \
    ROS_LOG_DIR="${IMAGE_MAIN_USER_HOME}/.ros/logs" \
    ROS_TEST_RESULTS_DIR="${IMAGE_MAIN_USER_HOME}/.ros/tests" \
    ROS_CONFIG_HOME="${IMAGE_MAIN_USER_HOME}/.config/ros.org" \
    RTI_NC_LICENSE_ACCEPTED="no" \
    RCUTILS_COLORIZED_OUTPUT="1" \
    RCUTILS_LOGGING_USE_STDOUT="1" \
    RCUTILS_LOGGING_BUFFERED_STREAM="1" \
    RCUTILS_CONSOLE_OUTPUT_FORMAT="[{severity}] {time} {name}: {message}" \
    ROS_DOMAIN_ID="0" \
{% if ros_distro == "humble" %}
    ROS_LOCALHOST_ONLY="1" \
{% else %}
    ROS_AUTOMATIC_DISCOVERY_RANGE="LOCALHOST" \
{% endif %}
    RMW_IMPLEMENTATION="rmw_fastrtps_cpp"

USER "${IMAGE_MAIN_USER}"
WORKDIR "${IMAGE_MAIN_USER_HOME}"
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
