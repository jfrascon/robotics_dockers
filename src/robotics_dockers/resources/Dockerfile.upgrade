# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom

# Pass the image to upgrade with one of these BuildKit-based forms:
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.upgrade --no-cache --build-arg BASE_IMAGE=<image:tag> -t <new-image:tag> .
#   docker buildx build -f Dockerfile.upgrade --no-cache --build-arg BASE_IMAGE=<image:tag> -t <new-image:tag> .
#
# docker buildx build is the modern Docker image build interface and uses
# BuildKit by design.
# DOCKER_BUILDKIT=1 keeps the classic docker build command on the BuildKit backend when buildx is
# not used explicitly.
# BASE_IMAGE has no safe generic default. Requiring it prevents an accidental
# upgrade of an unrelated image; the parser directive suppresses only the
# corresponding default-value warning.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
SHELL ["/bin/bash", "-c"]

RUN <<'EOF'
apt-get update || { echo "Error: apt package indexes could not be updated" >&2; exit 1; }
apt-get dist-upgrade --yes || { echo "Error: the image upgrade failed" >&2; exit 1; }
apt-get clean || { echo "Error: the apt cache could not be cleaned" >&2; exit 1; }
find /var/lib/apt/lists -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || {
    echo "Error: apt package indexes could not be removed" >&2
    exit 1
}
EOF
