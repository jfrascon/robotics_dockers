#!/usr/bin/env bash
# This file is sourced by the container user's .bashrc to set up an interactive shell.

# Source developer environment variables and functions, if present.
# shellcheck disable=SC1091
if [ -f "${HOME}/.env.rc" ]; then
    . "${HOME}/.env.rc"
fi

# Utility functions.
# .env.rc sets ROBOTICS_DOCKERS_ENV_LOADED=1 after it runs once, so later attempts to source it
# return immediately.
# This function removes that guard and sources .env.rc again in the current shell, which is useful
# after editing .env.rc or .ros.rc during an interactive session.
reload_envrc() {
    unset ROBOTICS_DOCKERS_ENV_LOADED

    if [ -f "${HOME}/.env.rc" ]; then
        # shellcheck disable=SC1091
        . "${HOME}/.env.rc"
    else
        echo "Warning: ${HOME}/.env.rc not found; nothing to reload" >&2
        return 1
    fi
}

# Optional local aliases.
# shellcheck disable=SC1091
if [ -f "${HOME}/.bash_aliases_user" ]; then
    . "${HOME}/.bash_aliases_user"
fi
