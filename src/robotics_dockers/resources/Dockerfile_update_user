# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom

# Create a local variant of an existing robotics-dockers image with different
# numeric identifiers. This is an optional adaptation path for developers
# who cannot afford to rebuild the original image. It is not used by the normal
# generated-image build or runtime path.
#
# Example:
#   docker build --file Dockerfile_update_user \
#     --build-arg BASE_IMAGE=my-image:latest \
#     --build-arg NEW_UID=1000 --build-arg NEW_GID=1000 \
#     --tag my-image:uid-1000 .

# BASE_IMAGE deliberately has no default: adapting an unintended image is more
# dangerous than requiring this argument. The parser check above suppresses only
# the warning that normally recommends a valid default for FROM.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG NEW_UID
ARG NEW_GID

USER root
SHELL ["/bin/bash", "-c"]

RUN --mount=type=bind,source=.resources/update_image_user.sh,target=/tmp/update_image_user.sh,readonly \
    bash /tmp/update_image_user.sh \
        "${NEW_UID}" "${NEW_GID}" "${ROBOTICS_DOCKERS_USER}" "${ROBOTICS_DOCKERS_USER_HOME}"

# Preserve the account names and home from the source image while publishing the
# new numeric contract for Compose files, derived images and runtime validation.
ENV ROBOTICS_DOCKERS_USER_ID="${NEW_UID}" \
    ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID="${NEW_GID}"

LABEL io.github.jfrascon.robotics-dockers.user.id="${NEW_UID}" \
    io.github.jfrascon.robotics-dockers.user.primary-group.id="${NEW_GID}"

# The source image supplies the textual account contract. The helper validates
# it before changing IDs, so USER and WORKDIR cannot target another account.
USER "${ROBOTICS_DOCKERS_USER}"
WORKDIR "${ROBOTICS_DOCKERS_USER_HOME}"
