#!/usr/bin/env bash
# This file is sourced by the container user's .bashrc to set up the ROS2 environment.

# ---------------------------------------------------------------------------
# source_base_ros_setup
#
# Sources the base ROS2 setup with the following priority:
#   1) ${ROS_DISTRO}/setup.bash if ROS_DISTRO is explicitly set
#   2) Auto-detect when exactly one distro is found in /opt/ros (sets ROS_DISTRO)
#
# Returns 0 on success, 1 when no valid ROS setup could be sourced.
# Emits a warning instead of exiting so the shell remains usable.
# ---------------------------------------------------------------------------
source_base_ros_setup() {
  local ros_setup_path=""
  local ros_setup_reason=""
  local ros_distro_count=0
  local detected_ros_distro=""
  local candidate=""

  if [ -n "${ROS_DISTRO}" ]; then
    if [ -s "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then
      ros_setup_path="/opt/ros/${ROS_DISTRO}/setup.bash"
    else
      ros_setup_reason="ROS_DISTRO is set to '${ROS_DISTRO}' but setup.bash was not found"
    fi
  elif [ -d "/opt/ros" ]; then
    for candidate in /opt/ros/*; do
      [ -d "${candidate}" ] || continue
      [ -s "${candidate}/setup.bash" ] || continue
      ros_distro_count=$((ros_distro_count + 1))
      detected_ros_distro="$(basename "${candidate}")"
    done

    if [ "${ros_distro_count}" -eq 1 ]; then
      export ROS_DISTRO="${detected_ros_distro}"
      ros_setup_path="/opt/ros/${ROS_DISTRO}/setup.bash"
      echo "Info: ROS_DISTRO unset; auto-selected '${ROS_DISTRO}' from /opt/ros" >&2
    elif [ "${ros_distro_count}" -gt 1 ]; then
      ros_setup_reason="ROS_DISTRO unset and multiple ROS distros found in /opt/ros"
    fi
  fi

  if [ -n "${ros_setup_path}" ]; then
    # shellcheck disable=SC1090
    if . "${ros_setup_path}"; then
      return 0
    fi
    echo "Warning: failed to source ${ros_setup_path}; continuing without ROS environment" >&2
    return 1
  fi

  echo "Warning: no ROS setup loaded (${ros_setup_reason:-no valid setup found}); continuing without ROS environment" >&2
  return 1
}

# ---------------------------------------------------------------------------
# Ensure ~/.local/bin is in PATH (user-local binaries installed by pip, etc.).
# The check avoids duplicating it if already present.
# ---------------------------------------------------------------------------
[[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]] && export PATH="${HOME}/.local/bin:${PATH}"

# ---------------------------------------------------------------------------
# ROS bootstrap: prefer workspace overlay, fall back to base ROS setup.
# ---------------------------------------------------------------------------
if [ -s "${HOME}/workspace/install/setup.bash" ]; then
  # shellcheck disable=SC1091
  if ! . "${HOME}/workspace/install/setup.bash"; then
    echo "Warning: failed to source workspace overlay; falling back to base ROS setup" >&2
    source_base_ros_setup
  fi
else
  source_base_ros_setup
fi

# ---------------------------------------------------------------------------
# Optional ROS tooling hooks.
# ---------------------------------------------------------------------------
# shellcheck disable=SC1091
[ -s /usr/share/gazebo/setup.sh ] && . /usr/share/gazebo/setup.sh
# shellcheck disable=SC1091
[ -s /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ] && . /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash
# shellcheck disable=SC1091
[ -s /usr/share/colcon_cd/function/colcon_cd.sh ] && . /usr/share/colcon_cd/function/colcon_cd.sh

# ---------------------------------------------------------------------------
# Local aliases (optional, non-fatal).
# ---------------------------------------------------------------------------
# shellcheck disable=SC1091
[ -f "${HOME}/.bash_aliases.user" ] && . "${HOME}/.bash_aliases.user"

# ---------------------------------------------------------------------------
# Deduplicate PATH variables to avoid unbounded growth on nested/repeated sources.
# Guarded: deduplicate_path may not be installed in all images.
# ---------------------------------------------------------------------------
if command -v deduplicate_path >/dev/null 2>&1; then
  PATH="$(deduplicate_path "${PATH}")"
  export PATH

  CMAKE_PREFIX_PATH="$(deduplicate_path "${CMAKE_PREFIX_PATH}")"
  export CMAKE_PREFIX_PATH

  LD_LIBRARY_PATH="$(deduplicate_path "${LD_LIBRARY_PATH}")"
  export LD_LIBRARY_PATH

  PKG_CONFIG_PATH="$(deduplicate_path "${PKG_CONFIG_PATH}")"
  export PKG_CONFIG_PATH

  PYTHONPATH="$(deduplicate_path "${PYTHONPATH}")"
  export PYTHONPATH

  AMENT_PREFIX_PATH="$(deduplicate_path "${AMENT_PREFIX_PATH}")"
  export AMENT_PREFIX_PATH

  AMENT_CURRENT_PREFIX="$(deduplicate_path "${AMENT_CURRENT_PREFIX}")"
  export AMENT_CURRENT_PREFIX

  COLCON_PREFIX_PATH="$(deduplicate_path "${COLCON_PREFIX_PATH}")"
  export COLCON_PREFIX_PATH
else
  echo "Warning: deduplicate_path not found; skipping environment path deduplication" >&2
fi
